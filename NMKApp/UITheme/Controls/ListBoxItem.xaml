                                  Style="{StaticResource ToolTipContent}" />
                              </ToggleButton.ToolTip>
                            </ToggleButton>
                            <ToggleButton
                              Width="25"
                              Height="25"
                              theme:UI.IconWidth="20"
                              theme:UI.IconHeight="20"
                              theme:UI.IconFalse="Send"
                              theme:UI.IconTrue="Send"
                              Padding="0"
                              BorderBrush="{DynamicResource ControlBorderBrush}"
                              Style="{StaticResource ToggleButtonIconRoundTransparentAll}"
                              Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}"
                              Command="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem, AncestorLevel=2}, Path=(theme:AttachedBehavior.CheckedCommand)}"
                              CommandParameter="{Binding}"
                              HorizontalAlignment="Right"
                              Margin="0 0 2 0"
                              Foreground="{DynamicResource ControlBackgroundBrush}"
                              Content="Checked">
                              <ToggleButton.ToolTip>
                                <ToolTip
                                  Content="Send checked"
                                  Style="{StaticResource ToolTipContent}" />
                              </ToggleButton.ToolTip>
                            </ToggleButton>
                          </StackPanel>
                          <ProgressBar
                            Visibility="{Binding IsProgress, Converter={StaticResource BoolConverter}}"
                            Margin="5"
                            HorizontalAlignment="Right"
                            Width="20"
                            Height="20"
                            theme:UI.Thickness="2"
                            Style="{StaticResource ProgressBarSpinner}"
                            Minimum="0"
                            Maximum="100"
                            Value="30" />
                        </Grid>
                      </Grid>
                      <Grid
                        VerticalAlignment="Top"
                        Visibility="{Binding IsAssignedTo, Converter={StaticResource BoolConverterReverse}}"
                        Grid.Row="0"
                        Grid.Column="2">
                        <Grid
                          Visibility="{Binding StatusVisible, Converter={StaticResource BoolConverter}}">
                          <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <ToggleButton
                              Width="25"
                              Height="25"
                              theme:UI.IconWidth="20"
                              theme:UI.IconHeight="20"
                              Margin="5 0"
                              theme:UI.IconFalse="Check"
                              theme:UI.IconTrue="Check"
                              Padding="0"
                              BorderBrush="{DynamicResource ControlBorderBrush}"
                              Style="{StaticResource ToggleButtonIconRoundTransparentAll}"
                              Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}"
                              Command="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem, AncestorLevel=2}, Path=(theme:AttachedBehavior.CompleteCommand)}"
                              CommandParameter="{Binding}"
                              Foreground="{DynamicResource ControlBackgroundBrush}"
                              Content="Complete">
                              <ToggleButton.ToolTip>
                                <ToolTip
                                  Content="Complete"
                                  Style="{StaticResource ToolTipContent}" />
                              </ToggleButton.ToolTip>
                            </ToggleButton>
                            <ToggleButton
                              Width="25"
                              Height="25"
                              theme:UI.IconWidth="20"
                              theme:UI.IconHeight="20"
                              theme:UI.IconFalse="Send"
                              theme:UI.IconTrue="Send"
                              Padding="0"
                              BorderBrush="{DynamicResource ControlBorderBrush}"
                              Style="{StaticResource ToggleButtonIconRoundTransparentAll}"
                              Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}"
                              Command="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem, AncestorLevel=2}, Path=(theme:AttachedBehavior.ReCheckedCommand)}"
                              CommandParameter="{Binding}"
                              Margin="0 0 2 0"
                              Foreground="{DynamicResource ControlBackgroundBrush}"
                              Content="ReChecked">
                              <ToggleButton.ToolTip>
                                <ToolTip
                                  Content="Send rechecked"
                                  Style="{StaticResource ToolTipContent}" />
                              </ToggleButton.ToolTip>
                            </ToggleButton>
                          </StackPanel>
                          <ProgressBar
                            Visibility="{Binding IsProgress, Converter={StaticResource BoolConverter}}"
                            Margin="5"
                            HorizontalAlignment="Right"
                            Width="20"
                            Height="20"
                            theme:UI.Thickness="2"
                            Style="{StaticResource ProgressBarSpinner}"
                            Minimum="0"
                            Maximum="100"
                            Value="30" />
                        </Grid>
                      </Grid>
                    </Grid>
                    <StackPanel
                      HorizontalAlignment="Left"
                      Grid.Row="2">
                      <StackPanel
                        Visibility="{Binding IsAssignedTo, Converter={StaticResource BoolConverterReverse}}"
                        Margin="0 0 0 5"
                        Orientation="Horizontal">
                        <TextBlock
                          FontWeight="Bold"
                          Text="AssignedTo : " />
                        <TextBlock
                          TextWrapping="Wrap"
                          Text="{Binding User.Email}" />
                      </StackPanel>
                      <StackPanel
                        Visibility="{Binding IsAssignedTo, Converter={StaticResource BoolConverter}}"
                        Margin="0 0 0 5"
                        Orientation="Horizontal">
                        <TextBlock
                          FontWeight="Bold"
                          Text="AssignedBy : " />
                        <TextBlock
                          TextWrapping="Wrap"
                          Text="{Binding CreateBy}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel
                      Margin="0 0 0 5"
                      VerticalAlignment="Bottom"
                      Grid.Row="1"
                      Grid.Column="0"
                      Orientation="Horizontal">
                      <TextBlock
                        FontWeight="Bold"
                        Text="Start : " />
                      <TextBlock
                        Text="{Binding DateStart , StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                    </StackPanel>
                    <StackPanel
                      Margin="0 0 10 5"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Grid.Row="1"
                      Grid.Column="1"
                      Orientation="Horizontal">
                      <TextBlock
                        FontWeight="Bold"
                        Text="End : " />
                      <TextBlock
                        Text="{Binding DateEnd , StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <!--<ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                Property="Background"
                Value="Transparent" />
              <Setter
                TargetName="Favorites"
                Property="Visibility"
                Value="Visible" />
              <Setter
                TargetName="ActionButton"
                Property="Visibility"
                Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>-->
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    x:Key="ListBoxItemProjectTask"
    BasedOn="{StaticResource BaseListBoxItem}"
    TargetType="ListBoxItem">
    <Setter
      Property="Background"
      Value="{Binding ColorState}" />
    <Setter
      Property="Visibility"
      Value="{Binding FilterStateVisible, Converter={StaticResource BoolConverter}}" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter
      Property="Margin"
      Value="0 1" />
    <Setter
      Property="MinHeight"
      Value="30" />
    <Setter
      Property="Height"
      Value="Auto" />
    <Style.Triggers>
      <Trigger
        Property="IsMouseOver"
        Value="True">
        <Setter
          Property="Background"
          Value="{Binding ColorState}" />
      </Trigger>
      <Trigger
        Property="IsSelected"
        Value="True">
        <Setter
          Property="Background"
          Value="{Binding ColorState}" />
      </Trigger>
      <DataTrigger
        Binding="{Binding IsBlink}"
        Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation
                Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                To="Orange"
                Duration="0:0:0.5"
                AutoReverse="True"
                RepeatBehavior="5x" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>