              </Grid.ColumnDefinitions>
              <Grid
                Margin="5">
                <!--<Image
                  Visibility="{Binding Is_Image, Converter={StaticResource BoolConverter}}"
                  Width="80"
                  Height="80"
                  Source="{Binding Image}">
                  <Image.Clip>
                    <EllipseGeometry
                      Center="40 40"
                      RadiusX="10"
                      RadiusY="10" />
                  </Image.Clip>
                </Image>-->
                <Grid
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
                  <ToggleButton
                    Content="{Binding Key}"
                    Style="{StaticResource ToggleButtonActive}"
                    Width="80"
                    Height="80" />
                </Grid>
              </Grid>
              <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center">
                <ToggleButton
                  Command="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(theme:AttachedBehavior.ClickCommand)}"
                  IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(theme:UI.IsChecked)}"
                  Padding="0"
                  theme:UI.PaddingContent="0"
                  Style="{StaticResource ToggleButtonTransparentAll}"
                  Margin="5"
                  FontWeight="SemiBold"
                  Content="{Binding name}" />
                <TextBlock
                  Margin="5"
                  Grid.Row="1"
                  VerticalAlignment="Center"
