<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
  xmlns:theme="clr-namespace:NMKApp.UITheme">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary
      Source="pack://application:,,,/NMKApp;component/UITheme/LightTheme.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/NMKApp;component/UITheme/Controls/ToggleButton.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/NMKApp;component/UITheme/Controls/Tooltip.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/NMKApp;component/UITheme/Converter.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style
    x:Key="BaseListBoxItem"
    TargetType="ListBoxItem">
    <Setter
      Property="MinHeight"
      Value="30" />
    <Setter
      Property="VerticalContentAlignment"
      Value="Center" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource ControlForegroundBrush}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ListBoxItem">
          <Border
            Margin="{TemplateBinding Margin}"
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            Padding="10 0 0 0"
            CornerRadius="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(theme:UI.BDCorner)}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="Auto" />
                <ColumnDefinition
                  Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel
                Orientation="Horizontal"></StackPanel>
              <ContentPresenter
                Grid.Column="1"
                VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                Property="Background"
                Value="{DynamicResource ControlHoverBackgroundBrush}" />
            </Trigger>
            <Trigger
              Property="IsSelected"
              Value="True">
              <Setter
                Property="Background"
                Value="{DynamicResource ControlSelectedBackgroundBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    BasedOn="{StaticResource BaseListBoxItem}"
    TargetType="ListBoxItem"></Style>
  <Style
    x:Key="ListBoxItemSelectedTransparent"
    BasedOn="{StaticResource BaseListBoxItem}"
    TargetType="ListBoxItem">
    <Style.Triggers>
      <Trigger
        Property="IsSelected"
        Value="True">
        <Setter
          Property="Background"
          Value="Transparent" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style
    TargetType="ListBoxItem"
    x:Key="ListBoxItemIcon">
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource ControlForegroundBrush}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ListBoxItem">
          <Border
            x:Name="Bd"
            Background="Transparent"
            Height="30">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="40" />
                <ColumnDefinition
                  Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel
                Orientation="Horizontal">
                <Border
                  x:Name="Stick"
                  Background="Transparent"
                  Width="4"
                  Height="20"
                  CornerRadius="2"
                  Margin="0 0 5 0" />
                <icon:MaterialIcon
                  Width="20"
                  Height="20"
                  Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.Icon)}" />
              </StackPanel>
              <ContentPresenter
                Grid.Column="1"
                VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="{DynamicResource ControlHoverBackgroundBrush}" />
            </Trigger>
            <Trigger
              Property="IsSelected"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="{DynamicResource ControlSelectedBackgroundBrush}" />
              <Setter
                TargetName="Stick"
                Property="Background"
                Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    x:Key="ListBoxItemTable"
    TargetType="ListBoxItem">
    <Setter
      Property="Margin"
      Value="5" />
    <Setter
      Property="BorderThickness"
      Value="1" />
    <Setter
      Property="BorderBrush"
      Value="{DynamicResource ControlBorderBrush}" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource ControlForegroundBrush}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ListBoxItem">
          <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.BDCorner)}"
            Padding="{TemplateBinding Padding}"
            Margin="{TemplateBinding Margin}">
            <Grid
              Width="120"
              Height="120">
              <Grid.RowDefinitions>
                <RowDefinition
                  Height="80" />
                <RowDefinition
                  Height="*" />
              </Grid.RowDefinitions>
              <CheckBox
                IsChecked="{Binding IsChecked}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="5" />
              <ToggleButton
                HorizontalAlignment="Left"
                theme:UI.IconWidth="20"
                theme:UI.IconHeight="20"
                Name="Favorites"
                Visibility="{Binding is_favorite, Converter={StaticResource BoolConverter}}"
                Style="{StaticResource ToggleButtonIconRoundTransparentAll}"
                theme:UI.IconFalse="StarOutline"
                theme:UI.IconTrue="Star"
                IsChecked="{Binding is_favorite, UpdateSourceTrigger=PropertyChanged}" />
              <Grid>
                <RadioButton
                  Cursor="Arrow"
                  Width="80"
                  Height="80"
                  theme:UI.IconWidth="70"
                  theme:UI.IconHeight="70"
                  Visibility="{Binding IsFolder, Converter={StaticResource BoolConverter}}"
                  Style="{DynamicResource RadioButtonRound}"
                  theme:UI.IconFalse="Folder"
                  theme:UI.ContentTrue="FolderShared"
                  IsChecked="{Binding IsShare}" />
                <Grid
                  Visibility="{Binding IsFolder, Converter={StaticResource BoolConverterReverse}}">
                  <Image
                    Source="{Binding Image}"
                    Width="70"
                    Height="70">
                    <Image.ToolTip>
                      <Image
                        Margin="5"
                        Source="{Binding Image}"
                        Width="200"
                        Height="200" />
                    </Image.ToolTip>
                  </Image>
                  <icon:MaterialIcon
                    Visibility="{Binding IsShare, Converter={StaticResource BoolConverter}}"
                    Background="{DynamicResource PrimaryBackgroundBrush}"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="5"
                    Width="15"
                    Height="15"
                    Kind="ShareVariantOutline" />
                </Grid>
              </Grid>
              <Grid
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Name="ActionButton">
                <ToggleButton
                  Visibility="{Binding IsFolder, Converter={StaticResource BoolConverter}}"
                  Style="{StaticResource ToggleButtonIconRoundPopupFolder}"
                  theme:AttachedBehavior.DownloadCommand="{Binding ElementName=window, Path=DataContext.FolderDownloadCommand}"
                  theme:AttachedBehavior.MoveCommand="{Binding ElementName=window, Path=DataContext.FolderMoveCommand}"
                  theme:AttachedBehavior.ShareCommand="{Binding ElementName=window, Path=DataContext.FolderShareCommand}"
                  theme:AttachedBehavior.RenameCommand="{Binding ElementName=window, Path=DataContext.FolderRenameCommand}"
                  theme:AttachedBehavior.NewFolderCommand="{Binding ElementName=window, Path=DataContext.FolderNewCommand}"
                  theme:AttachedBehavior.DeleteCommand="{Binding ElementName=window, Path=DataContext.FolderDeleteCommand}" />
                <ToggleButton
                  Visibility="{Binding IsFolder, Converter={StaticResource BoolConverterReverse}}"
                  Style="{StaticResource ToggleButtonIconRoundPopupFamilies}"
                  theme:AttachedBehavior.DownloadCommand="{Binding ElementName=window, Path=DataContext.FamiliesDownloadCommand}"
                  theme:AttachedBehavior.MoveCommand="{Binding ElementName=window, Path=DataContext.FamiliesMoveCommand}"
                  theme:AttachedBehavior.ShareCommand="{Binding ElementName=window, Path=DataContext.FamiliesShareCommand}"
                  theme:AttachedBehavior.RenameCommand="{Binding ElementName=window, Path=DataContext.FamiliesRenameCommand}"
                  theme:AttachedBehavior.LoadToProjectCommand="{Binding ElementName=window, Path=DataContext.FamiliesLoadtoProjectCommand}"
                  theme:AttachedBehavior.DeleteCommand="{Binding ElementName=window, Path=DataContext.FamiliesDeleteCommand}" />
              </Grid>
              <TextBlock
                Cursor="Hand"
                TextAlignment="Center"
                Grid.Row="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                Text="{Binding name}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                Property="Background"
                Value="Transparent" />
              <Setter
                TargetName="Favorites"
                Property="Visibility"
                Value="Visible" />
              <Setter
                TargetName="ActionButton"
                Property="Visibility"
                Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
