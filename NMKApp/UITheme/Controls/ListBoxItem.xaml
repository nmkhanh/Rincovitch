                      <RowDefinition
                        MinHeight="40"
                        Height="*" />
                      <RowDefinition
                        Height="Auto" />
                      <RowDefinition
                        Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                      Margin="0 5 0 0">
