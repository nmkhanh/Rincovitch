            <ListBox
              VirtualizingStackPanel.ScrollUnit="Pixel"
              ScrollViewer.VerticalScrollBarVisibility="Hidden"
              ItemContainerStyle="{DynamicResource ListBoxItemProjectTask}"
              Grid.Row="1"
              ItemsSource="{Binding Tasks}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid
                    Width="280"
                    Background="Transparent"
                    Cursor="Hand">
                    <i:Interaction.Triggers>
                      <i:EventTrigger
                        EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction
                          Command="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem, AncestorLevel=2}, Path=(theme:AttachedBehavior.EditCommand)}"
                          CommandParameter="{Binding }" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
