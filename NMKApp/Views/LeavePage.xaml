<!-- LeavePage.xaml — Leave request management (DataContext: LeaveViewModel) -->
<UserControl
  x:Class="NMKApp.Views.LeavePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignHeight="600"
  d:DesignWidth="900">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!--#region Toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource PrimaryBorderBrush}"
            Padding="12 6">
      <WrapPanel>
        <Button Content="Apply Leave"
                Command="{Binding ApplyCommand}"
                Style="{StaticResource ButtonPrimaryStyle}"
                Margin="0 0 6 0"/>
      </WrapPanel>
    </Border>
    <!--#endregion-->

    <!--#region Leave Split View -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- My Leave requests -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Padding="12 6" BorderThickness="0 0 0 1"
                BorderBrush="{DynamicResource PrimaryBorderBrush}">
          <TextBlock Text="My Leave Requests" FontWeight="SemiBold" FontSize="13"/>
        </Border>
        <ListView Grid.Row="1"
                  ItemsSource="{Binding DataContext.LeavesAssignToCollection, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedItem="{Binding SelectedLeave}"
                  BorderThickness="0" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="BorderThickness" Value="0 0 0 1"/>
              <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Margin="12 8" Background="{Binding Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Type}" FontSize="13" FontWeight="Medium"/>
                  <TextBlock FontSize="11" Opacity="0.6">
                    <Run Text="To: "/>
                    <Run Text="{Binding SendTo}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Reason}" FontSize="11" Opacity="0.5"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                           Text="{Binding CreateAt, StringFormat=dd/MM/yy}" Opacity="0.5"/>
                <!-- Approval badge -->
                <Border Grid.Column="2" CornerRadius="4" Padding="6 2"
                        VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#FF9800"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Approval}" Value="1">
                          <Setter Property="Background" Value="#4CAF50"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Approval}" Value="0">
                          <Setter Property="Background" Value="#F44336"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock FontSize="10" Foreground="White">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Pending"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Approval}" Value="1">
                            <Setter Property="Text" Value="Approved"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Approval}" Value="0">
                            <Setter Property="Text" Value="Rejected"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>

      <GridSplitter Grid.Column="1" Width="4"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource PrimaryBorderBrush}"/>

      <!-- Incoming Leave requests to approve (Leader/Admin) -->
      <Grid Grid.Column="2"
            Visibility="{Binding DataContext.RoleVisible.VisibleLeader, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Padding="12 6" BorderThickness="0 0 0 1"
                BorderBrush="{DynamicResource PrimaryBorderBrush}">
          <TextBlock Text="Requests to Approve" FontWeight="SemiBold" FontSize="13"/>
        </Border>
        <ListView Grid.Row="1"
                  ItemsSource="{Binding DataContext.LeavesCollection, RelativeSource={RelativeSource AncestorType=Window}}"
                  SelectedItem="{Binding SelectedLeave}"
                  BorderThickness="0" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="BorderThickness" Value="0 0 0 1"/>
              <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Margin="12 8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="13" FontWeight="Medium">
                    <Run Text="{Binding UserCreateBy.Name}"/>
                    <Run Text=" — "/>
                    <Run Text="{Binding Type}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Reason}" FontSize="11" Opacity="0.5"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock FontSize="11" Opacity="0.5">
                    <Run Text="Days: "/>
                    <Run Text="{Binding LeaveList.Count, Mode=OneWay}"/>
                    <Run Text="  ·  "/>
                    <Run Text="{Binding CreateAt, StringFormat=dd/MM/yy}"/>
                  </TextBlock>
                </StackPanel>
                <!-- Approve/Reject buttons only for pending -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Approval}" Value="1">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Approval}" Value="0">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Button Content="✓ Approve"
                          Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Height="26" FontSize="11"
                          Style="{StaticResource ButtonSuccessStyle}"
                          Margin="2 0"/>
                  <Button Content="✕ Reject"
                          Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"
                          Height="26" FontSize="11"
                          Style="{StaticResource ButtonDangerStyle}"
                          Margin="2 0"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>
    <!--#endregion-->
  </Grid>
</UserControl>
