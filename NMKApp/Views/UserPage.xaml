<!-- UserPage.xaml — User management (DataContext: UserViewModel) -->
<UserControl
  x:Class="NMKApp.Views.UserPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignHeight="600"
  d:DesignWidth="800">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!--#region Toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource PrimaryBorderBrush}"
            Padding="12 6">
      <WrapPanel>
        <Button Content="New User"
                Command="{Binding UserAddCommand}"
                Style="{StaticResource ButtonPrimaryStyle}"
                Margin="0 0 6 0"/>
        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4 0"/>
        <TextBox Width="180" Height="28"
                 Text="{Binding NmkM.SearchUser, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6 4"
                 ToolTip="Search users..."/>
      </WrapPanel>
    </Border>
    <!--#endregion-->

    <!--#region User List -->
    <ListView Grid.Row="1"
              ItemsSource="{Binding NmkM.UsersCollection}"
              SelectedItem="{Binding NmkM.SelectedUser}"
              BorderThickness="0"
              Background="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="BorderThickness" Value="0 0 0 1"/>
          <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid Margin="12 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="100"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Avatar circle -->
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{Binding Color}">
              <TextBlock Text="{Binding Name[0]}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="16" FontWeight="Bold" Foreground="White"/>
            </Border>

            <!-- Name + Email -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8 0">
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Email}" FontSize="11" Opacity="0.5"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Team -->
            <TextBlock Grid.Column="2" Text="{Binding Team}" VerticalAlignment="Center"
                       FontSize="12" Opacity="0.7" Margin="4 0"/>

            <!-- Role badge -->
            <Border Grid.Column="3" CornerRadius="4" Padding="6 2" Margin="4 0"
                    VerticalAlignment="Center">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#607D8B"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Role}" Value="admin">
                      <Setter Property="Background" Value="#F44336"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Role}" Value="leader">
                      <Setter Property="Background" Value="#FF9800"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Role}" Value="adminapp">
                      <Setter Property="Background" Value="#9C27B0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding Role}" FontSize="10" Foreground="White"/>
            </Border>

            <!-- Create date -->
            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Opacity="0.5"
                       Text="{Binding CreateAt, StringFormat=dd/MM/yyyy}"/>

            <!-- Action buttons -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="🖼"
                      Command="{Binding DataContext.UserImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      Width="28" Height="26" FontSize="13"
                      Style="{StaticResource ButtonSecondaryStyle}"
                      ToolTip="Change photo"
                      Margin="2 0"/>
              <Button Content="Edit"
                      Command="{Binding DataContext.UserEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      Width="44" Height="26" FontSize="11"
                      Style="{StaticResource ButtonSecondaryStyle}"
                      Margin="2 0"/>
              <Button Content="✕"
                      Command="{Binding DataContext.UserDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      Width="28" Height="26" FontSize="11"
                      Style="{StaticResource ButtonDangerStyle}"
                      Margin="2 0"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <!--#endregion-->
  </Grid>
</UserControl>
