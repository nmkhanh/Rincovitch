<!-- SchedulePage.xaml — Work schedule calendar grid (DataContext: ScheduleViewModel) -->
<UserControl
  x:Class="NMKApp.Views.SchedulePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignHeight="700"
  d:DesignWidth="1000">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!--#region Toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource PrimaryBorderBrush}"
            Padding="12 6">
      <WrapPanel>
        <TextBlock Text="From" VerticalAlignment="Center" Margin="0 0 6 0" FontSize="12"/>
        <DatePicker Width="120" Height="28"
                    SelectedDate="{Binding NmkM.MinDaySchedules, Mode=TwoWay}"
                    Margin="0 0 8 0"/>
        <TextBlock Text="To" VerticalAlignment="Center" Margin="0 0 6 0" FontSize="12"/>
        <DatePicker Width="120" Height="28"
                    SelectedDate="{Binding NmkM.MaxDaySchedules, Mode=TwoWay}"
                    Margin="0 0 8 0"/>
        <Button Content="Apply Range"
                Command="{Binding FilterDayScheduleCommand}"
                Style="{StaticResource ButtonSecondaryStyle}"
                Margin="0 0 6 0"/>
      </WrapPanel>
    </Border>
    <!--#endregion-->

    <!--#region Schedule Grid -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Day header row -->
      <Border Background="{DynamicResource SecondaryBackgroundBrush}"
              BorderThickness="0 0 0 1" BorderBrush="{DynamicResource PrimaryBorderBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding NmkM.DaysSchedules}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="60" Padding="4 6" BorderThickness="0 0 1 0"
                        BorderBrush="{DynamicResource PrimaryBorderBrush}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                          <Setter Property="Background" Value="#1AF44336"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Name, StringFormat=ddd}"
                               FontSize="10" Opacity="0.5"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Name, StringFormat=dd/MM}"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                    <!-- Holiday label -->
                    <TextBlock Text="{Binding Holiday}" FontSize="9"
                               Foreground="#F44336"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="58"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- User schedule rows -->
      <ScrollViewer Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding NmkM.UsersCollection}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- User label -->
                <Border Grid.Column="0" Padding="12 8"
                        BorderThickness="0 0 1 1"
                        BorderBrush="{DynamicResource PrimaryBorderBrush}"
                        Background="{DynamicResource SecondaryBackgroundBrush}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Team}" FontSize="10" Opacity="0.5"/>
                  </StackPanel>
                </Border>

                <!-- Day cells -->
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding NmkM.DaysSchedules, RelativeSource={RelativeSource AncestorType=Window}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="60" Height="48"
                              BorderThickness="0 0 1 1"
                              BorderBrush="{DynamicResource PrimaryBorderBrush}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Background" Value="#1AF44336"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter Property="Background" Value="#1A4CAF50"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <!--#endregion-->
  </Grid>
</UserControl>
