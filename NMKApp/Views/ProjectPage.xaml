<!-- ProjectPage.xaml — Project management (DataContext: ProjectViewModel) -->
<UserControl
  x:Class="NMKApp.Views.ProjectPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignHeight="600"
  d:DesignWidth="900">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!--#region Toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource PrimaryBorderBrush}"
            Padding="12 6">
      <WrapPanel>
        <Button Content="New Project"
                Command="{Binding ProjectAddCommand}"
                Style="{StaticResource ButtonPrimaryStyle}"
                Margin="0 0 6 0"/>
        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4 0"/>
        <TextBox Width="180" Height="28"
                 Text="{Binding NmkM.SearchProject, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6 4"
                 ToolTip="Search projects..."/>
      </WrapPanel>
    </Border>
    <!--#endregion-->

    <!--#region Project List -->
    <ListView Grid.Row="1"
              ItemsSource="{Binding NmkM.ProjectsCollection}"
              BorderThickness="0"
              Background="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="BorderThickness" Value="0 0 0 1"/>
          <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid Margin="12 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="80"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Color indicator / image -->
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{Binding Color}">
              <TextBlock Text="{Binding Key}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" FontSize="12"
                         FontWeight="Bold" Foreground="White"/>
            </Border>

            <!-- Name + Description -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8 0">
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.5"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Revit version -->
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                       Text="{Binding RevitVersion}" Opacity="0.6" Margin="4 0"/>

            <!-- Task count -->
            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Opacity="0.5">
              <Run Text="Tasks: "/>
              <Run Text="{Binding Tasks.Count, Mode=OneWay}"/>
            </TextBlock>

            <!-- Action buttons -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="🎨"
                      Command="{Binding DataContext.ProjectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      Width="28" Height="26" FontSize="13"
                      Style="{StaticResource ButtonSecondaryStyle}"
                      ToolTip="Change color"
                      Margin="2 0"/>
              <Button Content="🖼"
                      Command="{Binding DataContext.ProjectImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      Width="28" Height="26" FontSize="13"
                      Style="{StaticResource ButtonSecondaryStyle}"
                      ToolTip="Change image"
                      Margin="2 0"/>
              <Button Content="Edit"
                      Command="{Binding DataContext.ProjectEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      Width="44" Height="26" FontSize="11"
                      Style="{StaticResource ButtonSecondaryStyle}"
                      Margin="2 0"/>
              <Button Content="✕"
                      Command="{Binding DataContext.ProjectDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      Width="28" Height="26" FontSize="11"
                      Style="{StaticResource ButtonDangerStyle}"
                      Margin="2 0"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <!--#endregion-->
  </Grid>
</UserControl>
