<!-- TemporaryPage.xaml — Temporary task list (DataContext: TemporaryViewModel) -->
<UserControl
  x:Class="NMKApp.Views.TemporaryPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignHeight="600"
  d:DesignWidth="800">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!--#region Toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderThickness="0 0 0 1" BorderBrush="{DynamicResource PrimaryBorderBrush}"
            Padding="12 6">
      <WrapPanel>
        <Button Content="New Item"
                Command="{Binding TemporaryAddTaskCommand}"
                Style="{StaticResource ButtonPrimaryStyle}"
                Margin="0 0 6 0"/>
        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4 0"/>
        <Button Content="Select All"
                Command="{Binding SelectAllCommand}"
                CommandParameter="True"
                Style="{StaticResource ButtonSecondaryStyle}"
                Margin="0 0 4 0"/>
        <Button Content="Deselect All"
                Command="{Binding SelectAllCommand}"
                CommandParameter="False"
                Style="{StaticResource ButtonSecondaryStyle}"
                Margin="0 0 4 0"/>
      </WrapPanel>
    </Border>
    <!--#endregion-->

    <!--#region Temporary Task List -->
    <ListView Grid.Row="1"
              ItemsSource="{Binding NmkM.TasksTemporaryCollection}"
              BorderThickness="0"
              Background="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="BorderThickness" Value="0 0 0 1"/>
          <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid Margin="12 8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Checkbox -->
            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      VerticalAlignment="Center"/>

            <!-- Task name -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4 0">
              <TextBlock Text="{Binding OnlyName}" FontSize="13" FontWeight="Medium"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.4"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Dates -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock FontSize="11" Opacity="0.5">
                <Run Text="Start: "/>
                <Run Text="{Binding DateStart, StringFormat=dd/MM/yy}"/>
              </TextBlock>
              <TextBlock FontSize="11" Opacity="0.5">
                <Run Text="Due:   "/>
                <Run Text="{Binding DateEnd, StringFormat=dd/MM/yy}"/>
              </TextBlock>
            </StackPanel>

            <!-- Assigned user -->
            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12"
                       Text="{Binding User.Name}" Opacity="0.6" Margin="4 0"/>

            <!-- Actions -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="✕"
                      Command="{Binding DataContext.TemporaryDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      Width="28" Height="26" FontSize="11"
                      Style="{StaticResource ButtonDangerStyle}"
                      Margin="2 0"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <!--#endregion-->

    <!--#region Bottom bar -->
    <Border Grid.Row="2"
            Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderThickness="0 1 0 0" BorderBrush="{DynamicResource PrimaryBorderBrush}"
            Padding="12 6">
      <DockPanel>
        <Button Content="Save to Tasks"
                Command="{Binding TemporarySaveCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonSuccessStyle}"
                Margin="6 0 0 0"/>
        <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.6">
          <Run Text="Items: "/>
          <Run Text="{Binding NmkM.TasksTemporaryCollection.Count, Mode=OneWay}" FontWeight="SemiBold"/>
        </TextBlock>
      </DockPanel>
    </Border>
    <!--#endregion-->
  </Grid>
</UserControl>
