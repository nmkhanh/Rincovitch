<Window x:Class="NMKApp.Views.Dialogs.LoginEmailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In" Width="420" Height="210"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

  <StackPanel Margin="24">
    <TextBlock Text="Could not sign in automatically." FontSize="13" Margin="0,0,0,4"/>
    <TextBlock Text="Enter your Microsoft / Outlook email to continue:" Margin="0,0,0,10" Foreground="#555"/>
    <TextBox x:Name="TxtEmail" Height="32" Padding="8,4"
             FontSize="13" VerticalContentAlignment="Center"
             BorderBrush="#1565c0" BorderThickness="1"
             KeyDown="TxtEmail_KeyDown"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0"
              Click="BtnCancel_Click"/>
      <Button Content="Continue" Width="90" Height="30"
              Background="#1565c0" Foreground="White" BorderThickness="0"
              Click="BtnOk_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
