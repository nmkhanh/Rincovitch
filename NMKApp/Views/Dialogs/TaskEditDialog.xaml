<Window x:Class="NMKApp.Views.Dialogs.TaskEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task" Width="500" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title -->
    <TextBlock Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <!-- Task Name -->
    <TextBlock Grid.Row="1" Text="Task Name" Margin="0,0,0,4" Opacity="0.6"/>
    <TextBox Grid.Row="2" x:Name="TxtName" Height="32" Padding="8,4"
             FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

    <!-- Project + User Row -->
    <Grid Grid.Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Project" Margin="0,0,0,4" Opacity="0.6"/>
        <ComboBox x:Name="CmbProject" Height="32" DisplayMemberPath="Name"
                  SelectedValuePath="Id" SelectedValue="{Binding SelectedProjectId, RelativeSource={RelativeSource AncestorType=Window}}"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Assign To" Margin="0,0,0,4" Opacity="0.6"/>
        <ComboBox x:Name="CmbUser" Height="32" DisplayMemberPath="Name"
                  SelectedValuePath="Id" SelectedValue="{Binding SelectedUserId, RelativeSource={RelativeSource AncestorType=Window}}"/>
      </StackPanel>
    </Grid>

    <!-- Date Row -->
    <Grid Grid.Row="4" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Start Date" Margin="0,0,0,4" Opacity="0.6"/>
        <DatePicker x:Name="DpStart" Height="32"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="End Date" Margin="0,0,0,4" Opacity="0.6"/>
        <DatePicker x:Name="DpEnd" Height="32"/>
      </StackPanel>
    </Grid>

    <!-- Description -->
    <TextBlock Grid.Row="5" Text="Description (optional)" Margin="0,0,0,4" Opacity="0.6"/>
    <TextBox Grid.Row="6" x:Name="TxtDescription" Height="80"
             Padding="8,6" FontSize="13" TextWrapping="Wrap"
             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
             Margin="0,0,0,16"/>

    <!-- Buttons -->
    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0"
              Click="BtnCancel_Click"/>
      <Button Content="Save" Width="90" Height="30"
              Background="#1565c0" Foreground="White" BorderThickness="0"
              Click="BtnSave_Click"/>
    </StackPanel>
  </Grid>
</Window>
