<Window x:Class="NMKApp.Views.Dialogs.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User" Width="420" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow" ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <TextBlock Grid.Row="1" Text="Name" Margin="0,0,0,4" Opacity="0.6"/>
    <TextBox Grid.Row="2" x:Name="TxtName" Height="32" Padding="8,4"
             FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

    <TextBlock Grid.Row="3" Text="Email" Margin="0,0,0,4" Opacity="0.6"/>
    <TextBox Grid.Row="4" x:Name="TxtEmail" Height="32" Padding="8,4"
             FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

    <!-- Role + Team -->
    <Grid Grid.Row="5" VerticalAlignment="Top">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Role" Margin="0,0,0,4" Opacity="0.6"/>
        <ComboBox x:Name="CmbRole" Height="32">
          <ComboBoxItem Content="user" Tag="user"/>
          <ComboBoxItem Content="leader" Tag="leader"/>
          <ComboBoxItem Content="admin" Tag="admin"/>
          <ComboBoxItem Content="adminapp" Tag="adminapp"/>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Team" Margin="0,0,0,4" Opacity="0.6"/>
        <TextBox x:Name="TxtTeam" Height="32" Padding="8,4" FontSize="13" VerticalContentAlignment="Center"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Click="BtnCancel_Click"/>
      <Button Content="Save" Width="90" Height="30"
              Background="#1565c0" Foreground="White" BorderThickness="0" Click="BtnSave_Click"/>
    </StackPanel>
  </Grid>
</Window>
