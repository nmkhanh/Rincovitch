<Window x:Class="NMKApp.Views.Dialogs.LeaveApplyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply for Leave" Width="500" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow" ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Apply for Leave" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <TextBlock Grid.Row="1" Text="Send To (email)" Margin="0,0,0,4" Opacity="0.6"/>
    <ComboBox Grid.Row="2" x:Name="CmbSendTo" Height="32" IsEditable="True"
              DisplayMemberPath="Email" SelectedValuePath="Email"
              SelectedValue="{Binding SendTo, RelativeSource={RelativeSource AncestorType=Window}}"
              Margin="0,0,0,10"/>

    <TextBlock Grid.Row="3" Text="CC (email, optional)" Margin="0,0,0,4" Opacity="0.6"/>
    <TextBox Grid.Row="4" x:Name="TxtCC" Height="32" Padding="8,4"
             FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

    <TextBlock Grid.Row="5" Text="Leave Type" Margin="0,0,0,4" Opacity="0.6"/>
    <ComboBox Grid.Row="6" x:Name="CmbType" Height="32" Margin="0,0,0,10">
      <ComboBoxItem Content="Annual Leave" IsSelected="True"/>
      <ComboBoxItem Content="Sick Leave"/>
      <ComboBoxItem Content="Unpaid Leave"/>
      <ComboBoxItem Content="Other"/>
    </ComboBox>

    <StackPanel Grid.Row="7" VerticalAlignment="Top">
      <TextBlock Text="Reason" Margin="0,0,0,4" Opacity="0.6"/>
      <TextBox x:Name="TxtReason" Height="80" Padding="8,6"
               FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto"/>
    </StackPanel>

    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Click="BtnCancel_Click"/>
      <Button Content="Submit" Width="90" Height="30"
              Background="#1565c0" Foreground="White" BorderThickness="0" Click="BtnSubmit_Click"/>
    </StackPanel>
  </Grid>
</Window>
