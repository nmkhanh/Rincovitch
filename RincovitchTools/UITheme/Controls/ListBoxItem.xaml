            Background="Transparent">
            <ContentPresenter
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="Transparent" />
            </Trigger>
            <Trigger
              Property="IsSelected"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
