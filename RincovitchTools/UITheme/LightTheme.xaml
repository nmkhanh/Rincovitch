<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light Theme Colors (silver-dominant, soft palette) -->
  
  <!-- Background Colors (pure white base with silver-tinted panels) -->
  <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#F5F6F7" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#EBEDEF" />

  <!-- Foreground Colors (near-black with silver mids) -->
  <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#1C1E21" />
  <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#6C7278" />
  <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#A0A4A8" />

  <!-- Border Colors (soft silver spectrum) -->
  <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#C0C4C8" />
  <SolidColorBrush x:Key="HoverBorderBrush" Color="#B0B4B8" />
  <SolidColorBrush x:Key="DisabledBorderBrush" Color="#E8EAEC" />

  <!-- Accent Colors (kept available but NOT used for controls) -->
  <SolidColorBrush x:Key="AccentBrush" Color="#FF6B00" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#E55D00" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#CC5200" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

  <!-- Accent Black variants -->
  <SolidColorBrush x:Key="AccentBlackBrush" Color="#000000" />
  <SolidColorBrush x:Key="AccentBlackHoverBrush" Color="#222222" />
  <SolidColorBrush x:Key="AccentBlackPressedBrush" Color="#111111" />
  <SolidColorBrush x:Key="AccentBlackForegroundBrush" Color="#FFFFFF" />
  <!-- Support Control Colors (silver-dominant throughout) -->
  <SolidColorBrush
    x:Key="SupportControlBackgroundBrush"
    Color="#FFEECC" />
  <!-- Control Colors (silver-dominant throughout) -->
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#F5F6F7" />
  <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#EBEDEF" />
  <SolidColorBrush x:Key="ControlSelectedBackgroundBrush" Color="#E0E3E6" />
  <SolidColorBrush x:Key="ControlSelectedHoverBackgroundBrush" Color="#D6DADD" />
  <SolidColorBrush x:Key="ControlDisabledBackgroundBrush" Color="#FAFBFC" />

  <SolidColorBrush x:Key="ControlForegroundBrush" Color="#1C1E21" />
  <SolidColorBrush x:Key="ControlSelectedForegroundBrush" Color="#1C1E21" />
  <SolidColorBrush x:Key="ControlDisabledForegroundBrush" Color="#A0A4A8" />

  <SolidColorBrush x:Key="ControlBorderBrush" Color="#C0C4C8" />
  <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#B0B4B8" />
  <SolidColorBrush x:Key="ControlSelectedBorderBrush" Color="#8C9096" />
  <SolidColorBrush x:Key="ControlSelectedHoverBorderBrush" Color="#7C8086" />
  <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#E8EAEC" />
</ResourceDictionary>