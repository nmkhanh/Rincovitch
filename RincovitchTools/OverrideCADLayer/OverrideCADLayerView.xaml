<Window
  x:Class="RincovitchTools.OverrideCADLayer.OverrideCADLayerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:modelChilds="clr-namespace:RincovitchTools.Print.Models.ModelChilds"
  Icon="C:\ProgramData\Autodesk\ApplicationPlugins\Rincovitch.bundle\Contents\Resources\RincovitchIcon.png"
  Title="OverrideCADLayer"
  Height="800"
  Width="500"
  xmlns:theme="clr-namespace:RincovitchTools.UITheme"
  Name="window">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
          Source="pack://application:,,,/RincovitchTools;component/UITheme/BaseTheme.xaml" />
        <ResourceDictionary
          Source="pack://application:,,,/RincovitchTools;component/UITheme/LightTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid
    Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="40" />
      <RowDefinition
        Height="Auto"
        MaxHeight="400"/>
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <TextBox
      theme:UI.Hint="Search..."
      Style="{StaticResource TextBoxTransparent}">
      <i:Interaction.Triggers>
        <i:EventTrigger
          EventName="KeyUp">
          <i:InvokeCommandAction
            Command="{Binding ElementName=window, Path=DataContext.SearchCommand}"
            CommandParameter="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </TextBox>
    <CheckBox
      Grid.Row="1"
      VerticalAlignment="Center"
      Content="Select All"
      IsChecked="{Binding SelectAll, Mode=TwoWay}" />
    <ListBox
      Grid.Row="2"
      ItemsSource="{Binding CADLayers}"
      SelectionMode="Multiple"
      Margin="0 10 0 10">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <CheckBox
            Content="{Binding Name}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <DataGrid
      Grid.Row="3"
      ItemsSource="{Binding OverrideItems}"
      AutoGenerateColumns="False"
      CanUserAddRows="True"
      CanUserDeleteRows="True"
      Margin="0 0 0 10">
      <DataGrid.Columns>
        <DataGridTemplateColumn
          Width="*"
          Header="Layer (Contains)">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox
                Text="{Binding LayerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn>
          <DataGridTemplateColumn.Header>
            <TextBlock
              Width="100"
              Text="Color"
              TextAlignment="Center"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ToggleButton
                Width="80"
                Height="25"
                Content="{Binding Color}"
                Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <ComboBox
      Grid.Row="4"
      Width="300"
      Height="30"
      HorizontalAlignment="Left"
      VerticalAlignment="Center"
      ItemsSource="{Binding OverrideOptions}"
      SelectedItem="{Binding SelectedOverrideOption, Mode=TwoWay}"
      theme:UI.Hint="View template" />
    <ToggleButton
      HorizontalAlignment="Right"
      Width="150"
      Grid.Row="4"
      Content="Apply Overrides"
      Height="30"
      Command="{Binding ApplyOverridesCommand}" />
  </Grid>
</Window>
