<Window
  x:Class="RincovitchTools.Step.StepERROR"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:RincovitchTools.Step"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:theme="clr-namespace:RincovitchTools.UITheme"
  Icon="C:\ProgramData\Autodesk\ApplicationPlugins\Rincovitch.bundle\Contents\Resources\RincovitchIcon.png"
  Title="Step (ERROR)"
  ResizeMode="NoResize"
  Height="800"
  Width="400"
  Name="window">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
          Source="pack://application:,,,/RincovitchTools;component/UITheme/BaseTheme.xaml" />
        <ResourceDictionary
          Source="pack://application:,,,/RincovitchTools;component/UITheme/LightTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <ListBox
      Name="ErrorList"
      Margin="10"
      ItemsSource="{Binding ErrorList}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <ToggleButton
            theme:UI.PaddingContent="0"
            Padding="0"
            Command="{Binding ElementName=window, Path=DataContext.SelectCommand}"
            CommandParameter="{Binding}"
            Style="{StaticResource ToggleButtonTransparentAll}"
            Content="{Binding id}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
