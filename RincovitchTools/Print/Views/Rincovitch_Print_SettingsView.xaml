<UserControl
  x:Class="RincovitchTools.Print.Views.Rincovitch_Print_SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:RincovitchTools.Print.Views"
  xmlns:modelChilds="clr-namespace:RincovitchTools.Print.Models.ModelChilds"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:views="clr-namespace:RincovitchTools.Print.Views"
  xmlns:theme="clr-namespace:RincovitchTools.UITheme"
  DataContext="{Binding NMK_VM.SettingsVM}"
  Name="window">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
          Source="pack://application:,,,/RincovitchTools;component/UITheme/BaseTheme.xaml" />
        <ResourceDictionary
          Source="pack://application:,,,/RincovitchTools;component/UITheme/LightTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
    </Grid.RowDefinitions>
    <!--#region Navigation-->
    <StackPanel
      Height="30"
      Margin="10 10 0 10"
      Orientation="Horizontal">
      <RadioButton
        Style="{StaticResource RadioButtonBottomLineStyle}"
        Content="PDF"
        Name="PDF"
        IsChecked="True"/>
      <RadioButton
        Style="{StaticResource RadioButtonBottomLineStyle}"
        Content="DWG"
        Name="DWG"/>
    </StackPanel>
    <Separator
      Margin="0 0 0 10"
      VerticalAlignment="Bottom"/>
    <!--#endregion-->
    <!--#region PDF-->
    <Grid
      Grid.Row="1"
      Visibility="{Binding ElementName=PDF, Path=IsChecked, Converter={StaticResource BoolConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition
          Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid
        Grid.Row="1"
        Margin="10 0 10 10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel
          Margin="0 0 5 0">
          <GroupBox
            Margin="0 0 0 20"
            Header="Paper Placement">
            <StackPanel>
              <RadioButton
                IsChecked="{Binding NMK_M.Settings_PDF.PaperPlacementCenter}"
                GroupName="PaperPlacement"
                Margin="0 10 0 10"
                Content="Center" />
              <StackPanel>
                <RadioButton
                  IsChecked="{Binding NMK_M.Settings_PDF.PaperPlacementOffsetFromCorner}"
                  Name="Offsetfromcorner"
                  VerticalAlignment="Center"
                  GroupName="PaperPlacement"
                  Content="Offset from corner" />
                <StackPanel
                  Margin="30 0 0 0"
                  IsEnabled="{Binding ElementName=Offsetfromcorner, Path=IsChecked}"
                  Orientation="Horizontal">
                  <RadioButton
                    IsChecked="{Binding NMK_M.Settings_PDF.OffsetNoMargin}"
                    GroupName="OffsetCorner"
                    Margin="0 10 0 10"
                    Content="No Margin" />
                  <RadioButton
                    IsChecked="{Binding NMK_M.Settings_PDF.OffsetPrinterLimit}"
                    GroupName="OffsetCorner"
                    Margin="10 10 0 10"
                    Content="Printer limit" />
                  <RadioButton
                    Name="UserDefined"
                    IsChecked="{Binding NMK_M.Settings_PDF.OffsetUserDefined}"
                    GroupName="OffsetCorner"
                    Margin="10 10 0 10"
                    Content="User Defined" />
                </StackPanel>
              </StackPanel>
              <StackPanel
                IsEnabled="{Binding ElementName=UserDefined, Path=IsChecked}"
                Margin="0 10 0 10"
                Orientation="Horizontal">
                <TextBlock
                  VerticalAlignment="Center"
                  Text="X (mm) - " />
                <TextBox
                  Text="{Binding NMK_M.Settings_PDF.OffsetX}"
                  VerticalContentAlignment="Center"
                  Padding="10 0 10 0"
                  Margin="5 0 5 0"
                  Width="100"
                  Height="30" />
                <TextBlock
                  VerticalAlignment="Center"
                  Text="Y (mm) - " />
                <TextBox
                  Text="{Binding NMK_M.Settings_PDF.OffsetY}"
                  VerticalContentAlignment="Center"
                  Padding="10 0 10 0"
                  Margin="5 0 5 0"
                  Width="100"
                  Height="30" />
              </StackPanel>
            </StackPanel>
          </GroupBox>
          <GroupBox
            Margin="0 0 0 20"
            Header="Zoom">
            <StackPanel>
              <RadioButton
                IsChecked="{Binding NMK_M.Settings_PDF.ZoomFitToPage}"
                GroupName="Zoom"
                Margin="0 10 0 10"
                Content="Fit to Page" />
              <StackPanel
                Margin="0 0 0 10"
                Orientation="Horizontal">
                <RadioButton
                  x:Name="Zoom"
                  IsChecked="{Binding NMK_M.Settings_PDF.ZoomCustom}"
                  GroupName="Zoom"
                  Margin="0 10 0 10"
                  Content="Zoom" />
                <TextBox
                  Text="{Binding NMK_M.Settings_PDF.ZoomPercentage}"
                  IsEnabled="{Binding ElementName=Zoom, Path=IsChecked}"
                  VerticalContentAlignment="Center"
                  Padding="10 0 10 0"
                  Margin="10 0 5 0"
                  Height="30"
                  Width="100" />
                <TextBlock
                  VerticalAlignment="Center"
                  Margin="0 0 10 0"
                  Text="% Size" />
              </StackPanel>
            </StackPanel>
          </GroupBox>
          <GroupBox
            Margin="0 0 0 20"
            Header="Printer">
            <StackPanel
              Orientation="Horizontal">
              <TextBlock
                Margin="5 30 30 30"
                VerticalAlignment="Center"
                Text="Printer" />
              <ComboBox
                IsEnabled="False"
                SelectedItem="{Binding NMK_M.Settings_PDF.SelectedPrinter}"
                ItemsSource="{Binding NMK_M.Settings_PDF.Printers}"
                Width="100"
                Height="30"
                VerticalContentAlignment="Center" />
            </StackPanel>
          </GroupBox>
        </StackPanel>
        <StackPanel
          Margin="5 0 5 0"
          Grid.Column="1">
          <GroupBox
            Margin="0 0 0 20"
            Header="Hidden Line Views">
            <StackPanel
              Margin="5">
              <TextBlock
                VerticalAlignment="Center"
                Text="Remove Lines Using" />
              <RadioButton
                IsChecked="{Binding NMK_M.Settings_PDF.VectorProcessing}"
                GroupName="HiddenLine"
                Margin="0 10 0 10"
                Content="Vector Processing" />
              <RadioButton
                IsChecked="{Binding NMK_M.Settings_PDF.RasterProcessing}"
                GroupName="HiddenLine"
                Content="Raster Processing" />
            </StackPanel>
          </GroupBox>
          <GroupBox
            Margin="0 0 0 20"
            Header="Appearance">
            <StackPanel>
              <StackPanel
                Margin="5 10 0 10"
                Orientation="Horizontal">
                <TextBlock
                  Margin="0 0 30 0"
                  VerticalAlignment="Center"
                  Text="Raster Quality" />
                <ComboBox
                  SelectedItem="{Binding NMK_M.Settings_PDF.SelectedRasterQuality}"
                  ItemsSource="{Binding NMK_M.Settings_PDF.RasterQualities}"
                  VerticalContentAlignment="Center"
                  Width="150"
                  Height="30" />
              </StackPanel>
              <StackPanel
                Margin="5 0 0 10"
                Orientation="Horizontal">
                <TextBlock
                  Margin="0 0 70 0"
                  VerticalAlignment="Center"
                  Text="Colors" />
                <ComboBox
                  SelectedItem="{Binding NMK_M.Settings_PDF.SelectedColor}"
                  ItemsSource="{Binding NMK_M.Settings_PDF.Colors}"
                  VerticalContentAlignment="Center"
                  Width="150"
                  Height="30" />
              </StackPanel>
            </StackPanel>
          </GroupBox>
        </StackPanel>
        <StackPanel
          Margin="5 0 0 0"
          Grid.Column="2">
          <GroupBox
            Margin="0 0 0 20"
            Header="Options">
            <StackPanel
              Margin="5">
              <CheckBox
                IsChecked="{Binding NMK_M.Settings_PDF.ViewLinksInBlue}"
                Margin="0 10 0 10"
                Content="View links in blue (Color prints only)" />
              <CheckBox
                IsChecked="{Binding NMK_M.Settings_PDF.HideRefWorkPlanes}"
                Margin="0 0 0 10"
                Content="Hide ref/work planes" />
              <CheckBox
                IsChecked="{Binding NMK_M.Settings_PDF.HideUnreferencedViewTags}"
                Margin="0 0 0 10"
                Content="Hide unreferenced view tags" />
              <CheckBox
                IsChecked="{Binding NMK_M.Settings_PDF.HideScopeBoxes}"
                Margin="0 0 0 10"
                Content="Hide scope boxes" />
              <CheckBox
                IsChecked="{Binding NMK_M.Settings_PDF.HideCropBoundaries}"
                Margin="0 0 0 10"
                Content="Hide crop boundaries" />
              <CheckBox
                IsChecked="{Binding NMK_M.Settings_PDF.ReplaceHalftoneWithThinLines}"
                Margin="0 0 0 10"
                Content="Replace haftone with thin lines" />
              <CheckBox
                IsChecked="{Binding NMK_M.Settings_PDF.RegionEdgesMaskCoincidentLines}"
                Content="Region edges mask coincident lines" />
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </Grid>
    </Grid>
    <!--#endregion-->
    <!--#region DWG-->
    <StackPanel
      Grid.Row="1"
      Visibility="{Binding ElementName=DWG, Path=IsChecked, Converter={StaticResource BoolConverter}}"
      VerticalAlignment="Top"
      Margin="10">
      <GroupBox
        Header="Select Export Setup">
        <StackPanel
          Margin="10"
          Orientation="Horizontal">
          <TextBlock
            Width="100"
            VerticalAlignment="Center"
            Text="Name" />
          <ComboBox
            MinWidth="200"
            VerticalAlignment="Center"
            Height="30"
            VerticalContentAlignment="Center"
            ItemsSource="{Binding NMK_M.Settings_DWG.ExportSetups}"
            SelectedItem="{Binding NMK_M.Settings_DWG.SelectedExportSetup}" />
        </StackPanel>
      </GroupBox>
      <CheckBox
        Margin="0 20 0 0"
        IsChecked="{Binding NMK_M.Settings_DWG.ExportViewsAsExternalReferences}"
        Content="Export views on sheets and links as external references" />
    </StackPanel>
    <!--#endregion-->
  </Grid>
</UserControl>
