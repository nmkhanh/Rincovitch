<UserControl
  x:Class="RincovitchTools.Print.Views.Rincovitch_Print_ParameterView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:RincovitchTools.Print.Views"
  xmlns:modelChilds="clr-namespace:RincovitchTools.Print.Models.ModelChilds"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:views="clr-namespace:RincovitchTools.Print.Views"
  xmlns:theme="clr-namespace:RincovitchTools.UITheme"
  xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
  DataContext="{Binding NMK_VM.ParameterVM}"
  Background="White"
  Name="window">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
          Source="pack://application:,,,/RincovitchTools;component/UITheme/BaseTheme.xaml" />
        <ResourceDictionary
          Source="pack://application:,,,/RincovitchTools;component/UITheme/LightTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      
      <CollectionViewSource
        x:Key="PDFName"
        Source="{Binding NMK_M.ViewSheetParameters_ListBox_PDF}">
        <CollectionViewSource.SortDescriptions>
          <scm:SortDescription
            PropertyName="Type"
            Direction="Ascending" />
          <scm:SortDescription
            PropertyName="Name"
            Direction="Ascending" />
        </CollectionViewSource.SortDescriptions>
      </CollectionViewSource>
      <CollectionViewSource
        x:Key="PDFIndex"
        Source="{Binding NMK_M.ViewSheetParameters_DataGrid_PDF}">
        <CollectionViewSource.SortDescriptions>
          <scm:SortDescription
            PropertyName="Index"
            Direction="Ascending" />
        </CollectionViewSource.SortDescriptions>
      </CollectionViewSource>
      <CollectionViewSource
        x:Key="DWGName"
        Source="{Binding NMK_M.ViewSheetParameters_DWG}">
        <CollectionViewSource.SortDescriptions>
          <scm:SortDescription
            PropertyName="Type"
            Direction="Ascending" />
          <scm:SortDescription
            PropertyName="Name"
            Direction="Ascending" />
        </CollectionViewSource.SortDescriptions>
      </CollectionViewSource>
      <CollectionViewSource
        x:Key="DWGIndex"
        Source="{Binding NMK_M.ViewSheetParameters_DWG}">
        <CollectionViewSource.SortDescriptions>
          <scm:SortDescription
            PropertyName="Index"
            Direction="Ascending" />
        </CollectionViewSource.SortDescriptions>
      </CollectionViewSource>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border
    Margin="100"
    VerticalAlignment="Stretch"
    HorizontalAlignment="Stretch"
    Background="{DynamicResource PrimaryBackgroundBrush}"
    BorderThickness="1"
    BorderBrush="{DynamicResource PrimaryBorderBrush}"
    CornerRadius="5">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="*" />
        <RowDefinition
          Height="Auto" />
      </Grid.RowDefinitions>
      <!--#region Header-->
      <Border
        Height="30"
        Background="{DynamicResource SecondaryBackgroundBrush}"
        CornerRadius="5">
        <Grid>
          <TextBlock
            Margin="10 0 0 0"
            VerticalAlignment="Center"
            Text="Custom file name" />
          <ToggleButton
            IsChecked="{Binding NMK_M.IsVisible_Window.Dialog_Parameter}"
            Name="Close"
            Style="{StaticResource ToggleButtonIconRoundTransparent}"
            HorizontalAlignment="Right"
            theme:UI.IconFalse="Close"
            theme:UI.IconTrue="Close" />
        </Grid>
      </Border>
      <!--#endregion-->
      <!--#region Body-->
      <Grid
        Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="Auto" />
          <ColumnDefinition
            Width="*" />
        </Grid.ColumnDefinitions>
        <!--#region Navigation-->
        <Border
          BorderThickness="0 0 1 0"
          BorderBrush="Silver"
          Grid.RowSpan="2">
          <StackPanel>
            <RadioButton
              Name="PDF"
              theme:UI.Icon="FilePdfBox"
              Style="{StaticResource RadioButtonIconContentVerticalStyle}"
              Content="PDF"
              IsChecked="{Binding NMK_M.IsVisible_Window.Dialog_Parameter_PDF}" /> 
              <!--IsChecked="True" />-->
            <RadioButton
              Name="DWG"
              theme:UI.Icon="FileCad"
              Style="{StaticResource RadioButtonIconContentVerticalStyle}"
              Content="DWG"
              IsChecked="{Binding NMK_M.IsVisible_Window.Dialog_Parameter_DWG}"/>
          </StackPanel>
        </Border>
        <!--#endregion-->
        <!--#region PDF-->
        <Grid
          Visibility="{Binding IsChecked, ElementName=PDF, Converter={StaticResource BoolConverter}}"
          Grid.Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              Width="Auto" />
            <ColumnDefinition
              Width="*" />
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox
              VerticalAlignment="Top"
              theme:UI.Hint="Search..."
              Margin="10"
              Width="300"
              Height="30"
              Text="{Binding NMK_M.Search_ParameterPDF, UpdateSourceTrigger=PropertyChanged}" />
            <ListBox
              Width="300"
              Margin="10 50 10 10"
              ItemsSource="{Binding NMK_M.ViewSheetParameters_ListBox_PDF}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid
                    Background="Transparent"
                    Name="item">
                    <CheckBox
                      Cursor="Hand"
                      Height="25"
                      VerticalContentAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="5 0 5 0"
                      IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                      Command="{Binding ElementName=window,Path=DataContext.CheckedUpdatePreviewCommand}"
                      CommandParameter="{Binding }">
                      <TextBlock
                        Grid.Column="1"
                        FontWeight="{Binding FontWeight}"
                        Margin="5 0 0 0"
                        VerticalAlignment="Center"
                        Text="{Binding Name}" />
                    </CheckBox>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ItemContainerStyle>
                <Style
                  TargetType="ListBoxItem">
                  <Setter
                    Property="HorizontalContentAlignment"
                    Value="Stretch" />
                  <Setter
                    Property="Visibility"
                    Value="{Binding IsChecked, Converter={StaticResource BoolConverterReverse}}" />
                  <Style.Triggers>
                    <Trigger
                      Property="IsSelected"
                      Value="True">
                      <Setter
                        Property="Background"
                        Value="Transparent" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </Grid>
          <Grid
            Grid.Column="1">
            <TextBox
              IsEnabled="False"
              VerticalAlignment="Top"
              theme:UI.Hint="Preview..."
              Margin="10"
              Height="30"
              Text="{Binding NMK_M.Preview_ParameterPDF, UpdateSourceTrigger=PropertyChanged}" />
            <DataGrid
              CanUserSortColumns="False"
              Margin="10 50 10 10"
              ItemsSource="{Binding NMK_M.ViewSheetParameters_DataGrid_PDF}"
              Grid.Row="1">
              <DataGrid.Columns>
                <DataGridTemplateColumn>
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <Label
                        Width="40"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Index" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        Margin="5 0 5 0"
                        Text="{Binding Index, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding ElementName=window,Path=DataContext.IndexUpdatePreviewCommand}"
                              CommandParameter="{Binding}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="5 0 5 0"
                        IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                        Command="{Binding ElementName=window,Path=DataContext.CheckedUpdatePreviewCommand}"
                        CommandParameter="{Binding }" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <Label
                        Width="80"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Prefix" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        Margin="5 0 5 0"
                        Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding ElementName=window,Path=DataContext.UpdatePreviewCommand}"
                              CommandParameter="{Binding}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                  Header="Parameter Name"
                  Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock
                        VerticalAlignment="Center"
                        Margin="5 0 5 0"
                        Text="{Binding Name}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <Label
                        Width="80"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Suffix" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        Margin="5 0 5 0"
                        Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding ElementName=window,Path=DataContext.UpdatePreviewCommand}"
                              CommandParameter="{Binding}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <Label
                        Width="80"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Separator" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        Margin="5 0 5 0"
                        Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding ElementName=window,Path=DataContext.UpdatePreviewCommand}"
                              CommandParameter="{Binding}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
              <DataGrid.RowStyle>
                <Style
                  TargetType="DataGridRow">
                  <Setter
                    Property="Visibility"
                    Value="{Binding IsChecked, Converter={StaticResource BoolConverter}}" />
                </Style>
              </DataGrid.RowStyle>
            </DataGrid>
          </Grid>
        </Grid>
        <!--#endregion-->
        <!--#region DWG-->
        <Grid
          Visibility="{Binding IsChecked, ElementName=DWG, Converter={StaticResource BoolConverter}}"
          Grid.Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              Width="Auto" />
            <ColumnDefinition
              Width="*" />
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox
              VerticalAlignment="Top"
              theme:UI.Hint="Search..."
              Margin="10"
              Width="300"
              Height="30"
              Text="{Binding NMK_M.Search_ParameterDWG, UpdateSourceTrigger=PropertyChanged}" />
            <ListBox
              Width="300"
              Margin="10 50 10 10"
              ItemsSource="{Binding NMK_M.ViewSheetParameters_ListBox_DWG}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid
                    Background="Transparent"
                    Name="item">
                    <CheckBox
                      Cursor="Hand"
                      Height="25"
                      VerticalContentAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="5 0 5 0"
                      IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                      Command="{Binding ElementName=window,Path=DataContext.CheckedUpdatePreviewCommand}"
                      CommandParameter="{Binding }">
                      <TextBlock
                        Grid.Column="1"
                        FontWeight="{Binding FontWeight}"
                        Margin="5 0 0 0"
                        VerticalAlignment="Center"
                        Text="{Binding Name}" />
                    </CheckBox>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ItemContainerStyle>
                <Style
                  TargetType="ListBoxItem">
                  <Setter
                    Property="HorizontalContentAlignment"
                    Value="Stretch" />
                  <Setter
                    Property="Visibility"
                    Value="{Binding IsChecked, Converter={StaticResource BoolConverterReverse}}" />
                  <Style.Triggers>
                    <Trigger
                      Property="IsSelected"
                      Value="True">
                      <Setter
                        Property="Background"
                        Value="Transparent" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </Grid>
          <Grid
            Grid.Column="1">
            <TextBox
              IsEnabled="False"
              VerticalAlignment="Top"
              theme:UI.Hint="Preview..."
              Margin="10"
              Height="30"
              Text="{Binding NMK_M.Preview_ParameterDWG, UpdateSourceTrigger=PropertyChanged}" />
            <DataGrid
              Margin="10 50 10 10"
              ItemsSource="{Binding NMK_M.ViewSheetParameters_DataGrid_DWG}"
              Grid.Row="1">
              <DataGrid.Columns>
                <DataGridTemplateColumn>
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <Label
                        Width="40"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Index" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        Margin="5 0 5 0"
                        Text="{Binding Index, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding ElementName=window,Path=DataContext.IndexUpdatePreviewCommand}"
                              CommandParameter="{Binding}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="5 0 5 0"
                        IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                        Command="{Binding ElementName=window,Path=DataContext.CheckedUpdatePreviewCommand}"
                        CommandParameter="{Binding }" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <Label
                        Width="80"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Prefix" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        Margin="5 0 5 0"
                        Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding ElementName=window,Path=DataContext.UpdatePreviewCommand}"
                              CommandParameter="{Binding}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                  Header="Parameter Name"
                  Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock
                        VerticalAlignment="Center"
                        Margin="5 0 5 0"
                        Text="{Binding Name}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <Label
                        Width="80"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Suffix" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        Margin="5 0 5 0"
                        Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding ElementName=window,Path=DataContext.UpdatePreviewCommand}"
                              CommandParameter="{Binding}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                  <DataGridTemplateColumn.HeaderTemplate>
                    <DataTemplate>
                      <Label
                        Width="80"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Separator" />
                    </DataTemplate>
                  </DataGridTemplateColumn.HeaderTemplate>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalContentAlignment="Center"
                        TextAlignment="Center"
                        Margin="5 0 5 0"
                        Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding ElementName=window,Path=DataContext.UpdatePreviewCommand}"
                              CommandParameter="{Binding}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
              <DataGrid.RowStyle>
                <Style
                  TargetType="DataGridRow">
                  <Setter
                    Property="Visibility"
                    Value="{Binding IsChecked, Converter={StaticResource BoolConverter}}" />
                </Style>
              </DataGrid.RowStyle>
            </DataGrid>
          </Grid>
        </Grid>
        <!--#endregion-->
      </Grid>
      <!--#endregion-->
      <!--#region Footer-->
      <Grid
        Grid.Row="2">
        <Grid>
          <StackPanel
            Orientation="Horizontal"
            Visibility="{Binding IsChecked, ElementName=PDF, Converter={StaticResource BoolConverter}}">
            <ToggleButton
              Margin="10"
              Width="80"
              Command="{Binding ElementName=window,Path=DataContext.ImportCommand}"
              Content="Import" />
            <ToggleButton
              Width="80"
              Command="{Binding ElementName=window,Path=DataContext.ExportCommand}"
              Content="Export" />
            <ComboBox
              DisplayMemberPath="Name"
              MinWidth="200"
              theme:UI.Hint="Select template"
              Margin="10"
              VerticalContentAlignment="Center"
              Height="30"
              ItemsSource="{Binding NMK_M.ViewSheetParameters_PDF_Selects}"
              SelectedItem="{Binding NMK_M.ViewSheetParameters_PDF_Select}">
              <i:Interaction.Triggers>
                <i:EventTrigger
                  EventName="DropDownClosed">
                  <i:InvokeCommandAction
                    Command="{Binding ElementName=window,Path=DataContext.SelectCommand}"
                    CommandParameter="{Binding }" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </ComboBox>
            <ToggleButton
              theme:UI.IconFalse="Close"
              theme:UI.IconTrue="Close"
              Style="{StaticResource ToggleButtonRound}"
              Command="{Binding ElementName=window,Path=DataContext.ClearCommand}" />
            <ToggleButton
              Margin="10"
              theme:UI.IconFalse="Sync"
              theme:UI.IconTrue="Sync"
              Style="{StaticResource ToggleButtonRound}"
              Command="{Binding ElementName=window,Path=DataContext.SyncCommand}" />
          </StackPanel>
          <StackPanel
            Orientation="Horizontal"
            Visibility="{Binding IsChecked, ElementName=DWG, Converter={StaticResource BoolConverter}}">
            <ToggleButton
              Margin="10"
              Width="80"
              Command="{Binding ElementName=window,Path=DataContext.ImportCommand}"
              Content="Import" />
            <ToggleButton
              Width="80"
              Command="{Binding ElementName=window,Path=DataContext.ExportCommand}"
              Content="Export" />
            <ComboBox
              DisplayMemberPath="Name"
              MinWidth="200"
              theme:UI.Hint="Select template"
              Margin="10"
              VerticalContentAlignment="Center"
              Height="30"
              ItemsSource="{Binding NMK_M.ViewSheetParameters_DWG_Selects}"
              SelectedItem="{Binding NMK_M.ViewSheetParameters_DWG_Select}">
              <i:Interaction.Triggers>
                <i:EventTrigger
                  EventName="DropDownClosed">
                  <i:InvokeCommandAction
                    Command="{Binding ElementName=window,Path=DataContext.SelectCommand}"
                    CommandParameter="{Binding }" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </ComboBox>
            <ToggleButton
              theme:UI.IconFalse="Close"
              theme:UI.IconTrue="Close"
              Style="{StaticResource ToggleButtonRound}"
              Command="{Binding ElementName=window,Path=DataContext.ClearCommand}" />
            <ToggleButton
              Margin="10"
              theme:UI.IconFalse="Sync"
              theme:UI.IconTrue="Sync"
              Style="{StaticResource ToggleButtonRound}"
              Command="{Binding ElementName=window,Path=DataContext.SyncCommand}" />
          </StackPanel>
        </Grid>
        <ToggleButton
          IsChecked="{Binding NMK_M.IsVisible_Window.Dialog_Parameter}"
          Style="{StaticResource ToggleButtonActive}"
          Margin="10"
          Width="80"
          HorizontalAlignment="Right"
          Command="{Binding ElementName=window,Path=DataContext.ApplyCommand}"
          Content="Apply" />
      </Grid>
      <!--#endregion-->
    </Grid>
  </Border>
</UserControl>
