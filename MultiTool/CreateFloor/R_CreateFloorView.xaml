<Window
  x:Class="MultiTool.CreateFloor.R_CreateFloorView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:MultiTool.CreateFloor"
  mc:Ignorable="d"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  Title="R_CreateFloorView"
  Height="200"
  Width="380"
  Name="window">
  <i:Interaction.Triggers>
    <i:EventTrigger
      EventName="Loaded">
      <i:InvokeCommandAction
        Command="{Binding ElementName=window,Path=DataContext.LoadedCommand}" />
    </i:EventTrigger>
  </i:Interaction.Triggers>
  <StackPanel
    Margin="10">
    <ComboBox
      VerticalContentAlignment="Center"
      Height="30"
      ItemsSource="{Binding VM.FloorType_s}"
      SelectedItem="{Binding VM.FloorType}"
      Name="FloorComboBox"
      VerticalAlignment="Top"
      Margin="10" 
      DisplayMemberPath="Name"/>
    <TextBox
      Text="{Binding VM.FloorName}"
      Name="FloorNameTextBox"
      VerticalAlignment="Top"
      Margin="10"
      Height="30"
      VerticalContentAlignment="Center"
      Padding="10,0,10,0"/>
    <Grid>
      <CheckBox
        Margin="10"
        Content="TopFace"
        IsChecked="{Binding VM.TopFace}" />
      <Button
        Click="CreateFloorButton_Click"
        Name="CreateFloorButton"
        Content="Create Floor"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Width="80"
        Height="30"
        Margin="10"
        Command="{Binding ElementName=window, Path=DataContext.RunCommand}" />
    </Grid>
  </StackPanel>
</Window>
