<Window
  x:Class="MultiTool.DisplaySettings.R_DisplaySettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:iconWPF="clr-namespace:Material.Icons;assembly=Material.Icons"
  xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
  Title="RVT Link Display Settings"
  Height="800"
  Width="1000"
  MinWidth="1000"
  MinHeight="800"
  Name="window">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--<ResourceDictionary
          Source="pack://application:,,,/RevitExport;component/Converter/Converter.xaml" />-->
        <ResourceDictionary
          Source="pack://application:,,,/MultiTool;component/Template/Button.xaml" />
        <ResourceDictionary
          Source="pack://application:,,,/MultiTool;component/Template/DataGrid.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <i:Interaction.Triggers>
    <i:EventTrigger
      EventName="Loaded">
      <i:InvokeCommandAction
        Command="{Binding ElementName=window,Path=DataContext.LoadedCommand}" />
    </i:EventTrigger>
  </i:Interaction.Triggers>
  <Grid
    Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <Grid
      Margin="0 10 0 10">
      <TextBox
        Height="30"
        VerticalContentAlignment="Center"
        Padding="10 0 50 0"
        VerticalAlignment="Center"
        Text="{Binding ElementName=window, Path=DataContext.VM.Search, UpdateSourceTrigger=PropertyChanged}" />
      <icon:MaterialIcon
        Kind="Search"
        Width="20"
        Height="20"
        VerticalAlignment="Center"
        Margin="0 0 10 0"
        HorizontalAlignment="Right" />
    </Grid>
    <DataGrid
      ItemsSource="{Binding VM.Data_s}"
      Grid.Row="1">
      <i:Interaction.Triggers>
        <i:EventTrigger
          EventName="MouseDoubleClick">
          <i:InvokeCommandAction
            Command="{Binding ViewActiveCommand}"
            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
      <DataGrid.RowStyle>
        <Style
          TargetType="DataGridRow"
          BasedOn="{StaticResource DataGridRowTransparent}" />
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTemplateColumn
          Header="Current"
          Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock
                VerticalAlignment="Center"
                Margin="10 0 0 0"
                Text="{Binding ViewCurrent.Name}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn
          Width="*">
          <DataGridTemplateColumn.Header>
            <ComboBox
              ItemsSource="{Binding ElementName=window, Path=DataContext.VM.Project_Link_s}"
              SelectedItem="{Binding ElementName=window, Path=DataContext.VM.Project_Link}"
              Height="30"
              VerticalContentAlignment="Center">
              <i:Interaction.Triggers>
                <i:EventTrigger
                  EventName="DropDownClosed">
                  <i:InvokeCommandAction
                    Command="{Binding ElementName=window,Path=DataContext.ChangeLinkCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <Label
                    Height="30"
                    VerticalAlignment="Center"
                    Content="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox
                Margin="5 0 5 0"
                ItemsSource="{Binding ViewLink_s, UpdateSourceTrigger=PropertyChanged}"
                SelectedItem="{Binding ViewLink, UpdateSourceTrigger=PropertyChanged}"
                Height="30"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <Label
                      Height="30"
                      VerticalAlignment="Center"
                      Content="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn
          Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button
                Cursor="Hand"
                Margin="5"
                Content="Run"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Height="30"
                Width="100"
                Command="{Binding ElementName=window, Path=DataContext.RunCommand}"
                CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid
      Margin="0 10 0 10"
      Grid.Row="2">
      <TextBlock
        Foreground="OrangeRed"
        VerticalAlignment="Center">
        <Run
          Text="{Binding VM.Data_Count}" />
      <Run
          Text=" Views" /></TextBlock>
      <Button
        Content="RunAll"
        HorizontalAlignment="Right"
        Height="30"
        Width="100"
        Command="{Binding ElementName=window, Path=DataContext.RunAllCommand}" />
    </Grid>
  </Grid>
</Window>
