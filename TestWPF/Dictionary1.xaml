<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:TestWPF">
  <Style
    TargetType="{x:Type local:PickDateTime}">
    <Setter
      Property="Background"
      Value="White" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="{x:Type local:PickDateTime}">
          <Border
            Padding="6"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#D0D0D0"
            Background="{TemplateBinding Background}">
            <DockPanel
              LastChildFill="True">
              <!-- Clear -->
              <Button
                Visibility="Collapsed"
                x:Name="PART_Clear"
                DockPanel.Dock="Right"
                Width="22"
                Height="22"
                Margin="6,0,0,0"
                Content="✕" />
              <StackPanel>
                <DatePicker
                  x:Name="PART_Date"
                  Width="120" />
                <TextBox
                  Margin="0 5"
                  x:Name="PART_Time"
                  TextAlignment="Center"
                  VerticalContentAlignment="Center"
                  ToolTip="HH:mm" />
                <!-- Time box + spinner -->
                <Grid
                  Margin="8,0,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition
                      Width="20" />
                  </Grid.ColumnDefinitions>
                  
                  <!--<StackPanel
                    Grid.Column="1">
                    <RepeatButton
                      Height="10"
                      Content="▲" />
                    <RepeatButton
                      Height="10"
                      Content="▼" />
                  </StackPanel>-->
                </Grid>
              </StackPanel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>