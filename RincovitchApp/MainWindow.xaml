        IsReadOnly="False"
        Margin="0 10"
        Grid.Row="2"
        ItemsSource="{Binding NMK_M.TasksTemporaryCollection}">
        <DataGrid.Columns>
          <DataGridTemplateColumn
            Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox
                  Margin="10 0"
                  VerticalAlignment="Center"
                  IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn
            Header="Project"
            Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox
                  Padding="0"
                  Style="{StaticResource ComboBoxTransparentAnyAll}"
                  DisplayMemberPath="Key"
                  IsEditable="True"
                  Margin="10 0"
                  IsSynchronizedWithCurrentItem="False"
                  SelectedValue="{Binding Project, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding ElementName=window, Path=DataContext.NMK_M.ProjectsCollectionNotProject}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn
            Header="User"
            Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox
                  Padding="0"
                  Style="{StaticResource ComboBoxTransparentAnyAll}"
                  DisplayMemberPath="Name"
                  IsEditable="True"
                  Margin="10 0"
                  IsSynchronizedWithCurrentItem="False"
                  SelectedValue="{Binding User, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding ElementName=window, Path=DataContext.NMK_M.UsersCollectionRole}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn
            Header="Task"
            Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition
                      Height="*" />
                    <RowDefinition
                      Height="*" />
                  </Grid.RowDefinitions>
                  <ComboBox
                    Margin="10 0"
                    Padding="0"
                    Style="{StaticResource ComboBoxTransparentAnyAllUpper}"
