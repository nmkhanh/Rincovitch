                    Margin="10 0"
                    theme:UI.Hint="Note"
                    Grid.Row="1"
                    CharacterCasing="Upper"
                    VerticalAlignment="Center"
                    Text="{Binding Detail, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn
            Width="60">
            <DataGridTemplateColumn.HeaderTemplate>
              <DataTemplate>
                <TextBlock
                  Width="40"
                  Text="Area"
                  TextAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.HeaderTemplate>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox
                  Width="50"
                  TextAlignment="Center"
                  BorderThickness="0"
                  Style="{StaticResource TextBoxTransparent}"
                  VerticalAlignment="Center"
                  Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn
            Header="Start"
            Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid
                  Margin="0 5">
                  <Grid.RowDefinitions>
                    <RowDefinition
                      Height="*" />
                    <RowDefinition
                      Height="*" />
                  </Grid.RowDefinitions>
                  <DatePicker
                    Margin="10 0"
                    SelectedDate="{Binding DateStart, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center"
                    Height="30" />
                  <Grid
                    Margin="10 10 0 0"
                    Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition
                        Width="Auto" />
                      <ColumnDefinition
                        Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                      theme:UI.Hint="HH"
                      Width="50"
                      TextAlignment="Center"
                      VerticalAlignment="Center"
                      Text="{Binding HourStart, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                      Grid.Column="1"
                      theme:UI.Hint="mm"
                      Width="50"
                      TextAlignment="Center"
                      VerticalAlignment="Center"
                      Text="{Binding MinutesStart, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn
            Header="      Day"
            Width="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox
                  theme:UI.Hint="Hour"
                  Width="80"
                  TextAlignment="Center"
                  BorderThickness="0"
                  Style="{StaticResource TextBoxTransparent}"
                  VerticalAlignment="Center"
                  Text="{Binding Day, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn
            Header="End"
            Width="170">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition
                      Width="*" />
                    <ColumnDefinition
                      Width="50" />
                  </Grid.ColumnDefinitions>
                  <Grid
                    Margin="0 5">
                    <Grid.RowDefinitions>
                      <RowDefinition
                        Height="*" />
                      <RowDefinition
                        Height="*" />
                    </Grid.RowDefinitions>
                    <DatePicker
                      Width="100"
                      IsEnabled="False"
                      Margin="10 0"
                      SelectedDate="{Binding DateEnd, UpdateSourceTrigger=PropertyChanged}"
                      VerticalContentAlignment="Center"
                      HorizontalAlignment="Left"
                      Height="30" />
                    <Grid
                      Margin="10 10 0 0"
                      Grid.Row="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition
                          Width="Auto" />
                        <ColumnDefinition
                          Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBox
                        theme:UI.Hint="HH"
                        Width="50"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding HourEnd, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBox
                        Grid.Column="1"
                        theme:UI.Hint="mm"
                        Width="50"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding MinutesEnd, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                  </Grid>
                  <Grid
                    Margin="10 0"
                    Grid.Column="1">
                    <Grid
                      x:Name="Delete"
                      Visibility="Collapsed">
                      <ToggleButton
                        Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}"
                        Width="25"
                        Height="25"
                        theme:UI.IconWidth="20"
                        theme:UI.IconHeight="20"
                        Command="{Binding ElementName=window,Path=DataContext.TemporaryDeleteCommand}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource ToggleButtonRound}"
                        ToolTip="Delete"
                        theme:UI.IconFalse="Close"
                        theme:UI.IconTrue="Close" />
                    </Grid>
                    <ProgressBar
                      theme:UI.Thickness="2"
                      x:Name="Progress"
                      Width="25"
                      Height="25"
                      IsIndeterminate="True"
                      Visibility="{Binding IsProgress, Converter={StaticResource BoolConverter}}"
                      Style="{StaticResource ProgressBarSpinner}" />
                  </Grid>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger
                    Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                    Value="True">
                    <Setter
                      TargetName="Delete"
                      Property="Visibility"
                      Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBox
        Grid.Row="0"
        Margin="10"
        TextWrapping="Wrap"
        AcceptsReturn="True"
        Text="{Binding NMK_M.SearchTaskTemporary, UpdateSourceTrigger=PropertyChanged}"
        theme:UI.Hint="Search..." />
      <StackPanel
        HorizontalAlignment="Left"
        Grid.Row="1"
        Orientation="Horizontal">
        <ToggleButton
          Margin="10 0"
          Command="{Binding ElementName=window,Path=DataContext.TemporarySelectAllCommand}"
          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Mode=Self}}"
          Width="120"
          Content="Select All"
          theme:UI.IconFalse="SelectAll" />
        <ToggleButton
          Command="{Binding ElementName=window,Path=DataContext.TemporaryAddCommand}"
          Width="120"
          Content="Add"
          theme:UI.IconFalse="Plus" />
      </StackPanel>
      <StackPanel
        HorizontalAlignment="Right"
        Grid.Row="1"
        Orientation="Horizontal">
        <ToggleButton
          Command="{Binding ElementName=window,Path=DataContext.TemporarySaveCommand}"
          Width="120"
          Style="{StaticResource ToggleButtonActive}"
          Content="Save"
          theme:UI.IconFalse="DatabaseArrowUpOutline" />
        <ToggleButton
          Margin="10 0"
          Command="{Binding ElementName=window,Path=DataContext.TemporaryAddTaskCommand}"
          Width="120"
          Style="{StaticResource ToggleButtonActive}"
          Content="Add Task"
          theme:UI.IconFalse="ChartTimeline" />
      </StackPanel>
    </Grid>
    <!--#endregion-->
