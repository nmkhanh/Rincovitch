<Window
  x:Class="RincovitchApp.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:RincovitchApp"
  xmlns:theme="clr-namespace:RincovitchApp.UITheme"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
  xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
  mc:Ignorable="d"
  Topmost="False"
  Title="RincovitchApp"
  Height="800"
  Width="1200"
  MinHeight="800"
  MinWidth="1200"
  Name="window"
  Background="{DynamicResource PrimaryBackgroundBrush}"
  Foreground="{DynamicResource PrimaryForegroundBrush}">
  <Window.TaskbarItemInfo>
    <shell:TaskbarItemInfo
      Overlay="{Binding NMK_M.TaskbarOverlay}"
      Description="Bạn có thông báo mới" />
  </Window.TaskbarItemInfo>
  <i:Interaction.Triggers>
    <i:EventTrigger
      EventName="Loaded">
      <i:InvokeCommandAction
        Command="{Binding ElementName=window,Path=DataContext.LoadCommand}"
        CommandParameter="{Binding ElementName=window}" />
    </i:EventTrigger>
    <i:EventTrigger
      EventName="Closing">
      <i:InvokeCommandAction
        PassEventArgsToCommand="True"
        Command="{Binding ElementName=window,Path=DataContext.ClosingCommand}" />
    </i:EventTrigger>
  </i:Interaction.Triggers>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition
        Width="60" />
      <ColumnDefinition
        Width="*" />
    </Grid.ColumnDefinitions>
    <!--#region Navigation-->
    <Border
      BorderBrush="{DynamicResource PrimaryBorderBrush}"
      BorderThickness="0 0 1 0">
      <Grid>
        <StackPanel>
          <Grid
            Visibility="{Binding NMK_M.RoleVisible.VisibleUser}">
            <RadioButton
              GroupName="Navigation"
              Content="Dashboard"
              Name="Dashboard"
              IsChecked="{Binding NMK_M.IsDashboard, UpdateSourceTrigger=PropertyChanged}"
              Style="{StaticResource RadioButtonIconContentVerticalStyle}"
              theme:UI.Icon="HomeOutline" />
            <Grid
              Visibility="{Binding NMK_M.TasksProjectCollectionCount.Count, Converter={StaticResource CountConverter}}"
              VerticalAlignment="Top"
              HorizontalAlignment="Right">
              <Border
                Width="20"
                Height="20"
                Margin="0 0 5 0"
                Background="{DynamicResource AccentBrush}"
                CornerRadius="10"
                IsHitTestVisible="False">
                <TextBlock
                  Foreground="{DynamicResource PrimaryBackgroundBrush}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Text="{Binding NMK_M.TasksProjectCollectionCount.Count}" />
              </Border>
            </Grid>
          </Grid>
          <Separator
            Visibility="{Binding NMK_M.RoleVisible.VisibleLeader}" />
          <RadioButton
            Visibility="{Binding NMK_M.RoleVisible.VisibleUser}"
            GroupName="Navigation"
            Content="TimeLine"
            Name="TimeLine"
            Style="{StaticResource RadioButtonIconContentVerticalStyle}"
            theme:UI.Icon="ChartTimeline" />
          <Grid
            Visibility="{Binding NMK_M.RoleVisible.VisibleLeader}">
            <RadioButton
              GroupName="Navigation"
              Content="Request"
              Name="Email"
              Style="{StaticResource RadioButtonIconContentVerticalStyle}"
              theme:UI.Icon="EmailOutline" />
            <Border
              Visibility="{Binding NMK_M.TasksEmailCollectionCount.Count, Converter={StaticResource CountConverter}}"
              VerticalAlignment="Top"
              HorizontalAlignment="Right"
              Width="20"
              Height="20"
              Margin="0 0 5 0"
              Background="{DynamicResource AccentBrush}"
              CornerRadius="10"
              IsHitTestVisible="False">
              <TextBlock
                Foreground="{DynamicResource PrimaryBackgroundBrush}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Text="{Binding NMK_M.TasksEmailCollectionCount.Count}" />
            </Border>
          </Grid>
          <Separator
            Visibility="{Binding NMK_M.RoleVisible.VisibleMiddle}" />
          <Grid
            Visibility="{Binding NMK_M.RoleVisible.VisibleMiddle}">
            <RadioButton
              GroupName="Navigation"
              Content="Users"
              Name="Users"
              Style="{StaticResource RadioButtonIconContentVerticalStyle}"
              theme:UI.Icon="UserOutline" />
          </Grid>
          <Grid
            Visibility="{Binding NMK_M.RoleVisible.VisibleAdmin}">
            <RadioButton
              GroupName="Navigation"
              Content="Projects"
              Name="Projects"
              Style="{StaticResource RadioButtonIconContentVerticalStyle}"
              theme:UI.Icon="Computer" />
          </Grid>
          <Separator
            Visibility="{Binding NMK_M.RoleVisible.VisibleLeader}" />
          <Grid
            Visibility="{Binding NMK_M.RoleVisible.VisibleLeader}">
            <RadioButton
              GroupName="Navigation"
              Content="Temporary"
              Name="Temporary"
              Style="{StaticResource RadioButtonIconContentVerticalStyle}"
              theme:UI.Icon="SitemapOutline" />
            <Border
              Visibility="{Binding NMK_M.TasksTemporary.Items.Count, Converter={StaticResource CountConverter}}"
              VerticalAlignment="Top"
              HorizontalAlignment="Right"
              Width="20"
              Height="20"
              Margin="0 0 5 0"
              Background="{DynamicResource AccentBrush}"
              CornerRadius="10"
              IsHitTestVisible="False">
              <TextBlock
                Foreground="{DynamicResource PrimaryBackgroundBrush}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Text="{Binding NMK_M.TasksTemporary.Items.Count}" />
            </Border>
          </Grid>
        </StackPanel>
        <StackPanel
          VerticalAlignment="Bottom">
          <Grid
            Visibility="{Binding NMK_M.RoleVisible.VisibleUser}">
            <RadioButton
              GroupName="Navigation"
              Content="Notify"
              Name="Notify"
              Style="{StaticResource RadioButtonIconContentVerticalStyle}"
              theme:UI.Icon="BellOutline" />
            <Border
              Visibility="{Binding NMK_M.NotifysCollectionCount.Count, Converter={StaticResource CountConverter}}"
              VerticalAlignment="Top"
              HorizontalAlignment="Right"
              Width="20"
              Height="20"
              Margin="0 0 5 0"
              Background="{DynamicResource AccentBrush}"
              CornerRadius="10"
              IsHitTestVisible="False">
              <TextBlock
                Foreground="{DynamicResource PrimaryBackgroundBrush}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Text="{Binding NMK_M.NotifysCollectionCount.Count}" />
            </Border>
          </Grid>
          <Separator />
          <Grid
            Visibility="{Binding NMK_M.RoleVisible.VisibleUser}">
            <RadioButton
              GroupName="Navigation"
              Content="Leave"
              Name="Leave"
              Style="{StaticResource RadioButtonIconContentVerticalStyle}"
              theme:UI.Icon="CalendarMonthOutline" />
            <Border
              Visibility="{Binding NMK_M.LeavesAssignToCollectionCount.Count, Converter={StaticResource CountConverter}}"
              VerticalAlignment="Top"
              HorizontalAlignment="Right"
              Width="20"
              Height="20"
              Margin="0 0 5 0"
              Background="{DynamicResource AccentBrush}"
              CornerRadius="10"
              IsHitTestVisible="False">
              <TextBlock
                Foreground="{DynamicResource PrimaryBackgroundBrush}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Text="{Binding NMK_M.LeavesAssignToCollectionCount.Count}" />
            </Border>
          </Grid>
          <RadioButton
            Visibility="{Binding NMK_M.RoleVisible.VisibleUser}"
            GroupName="Navigation"
            Content="Schedule"
            Name="Schedule"
            Style="{StaticResource RadioButtonIconContentVerticalStyle}"
            theme:UI.Icon="Table" />
          <Separator />
          <ToggleButton
            Command="{Binding ElementName=window, Path=DataContext.RefreshCommand}"
            Visibility="{Binding NMK_M.RoleVisible.VisibleUser}"
            Content="Refresh"
            Name="Refresh"
            Style="{StaticResource ToggleButtonVertical}"
            theme:UI.IconFalse="Sync"
            theme:UI.IconTrue="Sync" />
          <RadioButton
            IsChecked="True"
            Visibility="{Binding NMK_M.RoleVisible.VisibleUser}"
            GroupName="Navigation"
            Content="Settings"
            Name="Settings"
            Style="{StaticResource RadioButtonIconContentVerticalStyle}"
            theme:UI.Icon="SettingsOutline" />
        </StackPanel>
      </Grid>
    </Border>
    <!--#endregion-->
    <!--#region Dashboard-->
    <Grid
      Grid.Column="1"
      Visibility="{Binding ElementName=Dashboard, Path=IsChecked, Converter={StaticResource BoolConverter}}">
      <ListBox
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        VirtualizingStackPanel.IsVirtualizing="True"
        VirtualizingStackPanel.ScrollUnit="Pixel"
        VirtualizingStackPanel.VirtualizationMode="Recycling"
        Margin="0 40 0 0"
        ItemsSource="{Binding NMK_M.TasksProjectCollection, UpdateSourceTrigger=PropertyChanged}">
        <ListBox.GroupStyle>
          <!--<GroupStyle>
            <GroupStyle.ContainerStyle>
              <Style
                TargetType="GroupItem">
                <Setter
                  Property="Template">
                  <Setter.Value>
                    <ControlTemplate
                      TargetType="GroupItem">
                      <ItemsPresenter
                        Visibility="{Binding Name, Converter={StaticResource BoolConverter}}" />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>-->
          <GroupStyle>
            <GroupStyle.Panel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel
                  Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </GroupStyle.Panel>
            <GroupStyle.ContainerStyle>
              <Style
                TargetType="GroupItem">
                <Setter
                  Property="Foreground"
                  Value="{DynamicResource ControlBackgroundBrush}" />
                <Setter
                  Property="Template">
                  <Setter.Value>
                    <ControlTemplate
                      TargetType="GroupItem">
                      <Grid
                        Height="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=ActualHeight}"
                        Background="Transparent"
                        Width="320">
                        <Grid.RowDefinitions>
                          <RowDefinition
                            Height="340" />
                          <RowDefinition
                            Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                          Background="{Binding Name.Color}"
                          BorderBrush="{Binding Name.Color}"
                          BorderThickness="1"
                          CornerRadius="4"
                          Padding="0"
                          Margin="2 2">
                          <Grid>
                            <Grid.RowDefinitions>
                              <RowDefinition
                                Height="200" />
                              <RowDefinition
                                Height="*" />
                            </Grid.RowDefinitions>
                            <ToggleButton
                              Command="{Binding ElementName=window, Path=DataContext.ProjectImageCommand}"
                              CommandParameter="{Binding Name}"
                              Padding="0"
                              theme:UI.PaddingContent="0"
                              BorderThickness="0"
                              Background="{StaticResource PrimaryBackgroundBrush}"
                              Width="Auto"
                              Height="Auto"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Style="{StaticResource ToggleButtonTransparentAll}">
                              <Image
                                Source="{Binding Name.Image}" />
                            </ToggleButton>
                            <StackPanel
                              Margin="10"
                              Grid.Row="1">
                              <Grid>
                                <TextBlock
                                  Text="Name : "
                                  FontWeight="Bold" />
                                <TextBlock
                                  Margin="80 0 0 0"
                                  TextWrapping="Wrap"
                                  Text="{Binding Name.Name}" />
                              </Grid>
                              <Grid
                                Margin="0 5">
                                <TextBlock
                                  Text="CreateAt : "
                                  FontWeight="Bold" />
                                <TextBlock
                                  Margin="80 0 0 0"
                                  TextWrapping="Wrap"
                                  Text="{Binding Name.CreateAt, StringFormat='{}{0:dd/MM/yyyy}'}" />
                              </Grid>
                              <Grid
                                Margin="0 0 0 5">
                                <TextBlock
                                  Text="Version : "
                                  FontWeight="Bold" />
                                <TextBlock
                                  Margin="80 0 0 0"
                                  TextWrapping="Wrap"
                                  Text="{Binding Name.RevitVersion, StringFormat='{}Autodesk Revit {0}'}" />
                              </Grid>
                              <Grid>
                                <TextBlock
                                  Text="Description : "
                                  FontWeight="Bold" />
                                <TextBlock
                                  Margin="80 0 0 0"
                                  TextWrapping="Wrap"
                                  Text="{Binding Name.Description}" />
                              </Grid>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <ListBox
                          VirtualizingStackPanel.ScrollUnit="Pixel"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.CanContentScroll="True"
                          ItemContainerStyle="{DynamicResource ListBoxItemProjectTask}"
                          Grid.Row="1"
                          ItemsSource="{Binding Items, UpdateSourceTrigger=PropertyChanged}">
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <Grid
                                theme:AttachedBehavior.DropCommand="{Binding ElementName=window, Path=DataContext.FilesDroppedCommand}"
                                Width="300"
                                Background="Transparent"
                                Cursor="Hand">
                                <i:Interaction.Triggers>
                                  <i:EventTrigger
                                    EventName="MouseLeftButtonUp">
                                    <i:InvokeCommandAction
                                      Command="{Binding ElementName=window, Path=DataContext.TaskEditCommand}"
                                      CommandParameter="{Binding }" />
                                  </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <Grid.RowDefinitions>
                                  <RowDefinition
                                    MinHeight="40"
                                    Height="*" />
                                  <RowDefinition
                                    Height="Auto" />
                                  <RowDefinition
                                    Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                  Margin="0 5 0 0">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                      Width="Auto" />
                                    <ColumnDefinition
                                      Width="*" />
                                    <ColumnDefinition
                                      Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <StackPanel
                                    Orientation="Horizontal">
                                    <TextBlock
                                      FontWeight="Bold"
                                      Text="{Binding State}" />
                                    <TextBlock
                                      Text=" : " />
                                  </StackPanel>
                                  <TextBlock
                                    Grid.Column="1"
                                    TextWrapping="Wrap"
                                    Text="{Binding OnlyName}" />
                                  <Grid
                                    VerticalAlignment="Top"
                                    Visibility="{Binding IsAssignedTo, Converter={StaticResource BoolConverter}}"
                                    Grid.Row="0"
                                    Grid.Column="2">
                                    <Grid
                                      Visibility="{Binding StatusVisible, Converter={StaticResource BoolConverter}}">
                                      <StackPanel
                                        Orientation="Horizontal">
                                        <Grid
                                          Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}">
                                          <ToggleButton
                                            Width="25"
                                            Height="25"
                                            theme:UI.IconWidth="20"
                                            theme:UI.IconHeight="20"
                                            Margin="0 0"
                                            theme:UI.IconFalse="LikeOutline"
                                            theme:UI.IconTrue="LikeOutline"
                                            Padding="0"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            Style="{StaticResource ToggleButtonIconRoundTransparentAll}"
                                            Visibility="{Binding StateAccepted, Converter={StaticResource BoolConverter}}"
                                            Command="{Binding ElementName=window, Path=DataContext.TaskAcceptCommand}"
                                            CommandParameter="{Binding}"
                                            Foreground="{DynamicResource ControlBackgroundBrush}"
                                            Content="Accept">
                                            <ToggleButton.ToolTip>
                                              <ToolTip
                                                Content="Accept"
                                                Style="{StaticResource ToolTipContent}" />
                                            </ToggleButton.ToolTip>
                                          </ToggleButton>
                                        </Grid>
                                        <ToggleButton
                                          Width="25"
                                          Height="25"
                                          theme:UI.IconWidth="20"
                                          theme:UI.IconHeight="20"
                                          Margin="5 0"
                                          theme:UI.IconFalse="TimerPlayOutline"
                                          theme:UI.IconTrue="TimerPlayOutline"
                                          Padding="0"
                                          BorderBrush="{DynamicResource ControlBorderBrush}"
                                          Style="{StaticResource ToggleButtonIconRoundTransparentAll}"
                                          Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}"
                                          Command="{Binding ElementName=window, Path=DataContext.TaskStartCommand}"
                                          CommandParameter="{Binding}"
                                          Foreground="{DynamicResource ControlBackgroundBrush}"
                                          Content="Start">
                                          <ToggleButton.ToolTip>
                                            <ToolTip
                                              Content="Start"
                                              Style="{StaticResource ToolTipContent}" />
                                          </ToggleButton.ToolTip>
                                        </ToggleButton>
                                        <ToggleButton
                                          Width="25"
                                          Height="25"
                                          theme:UI.IconWidth="20"
                                          theme:UI.IconHeight="20"
                                          theme:UI.IconFalse="Send"
                                          theme:UI.IconTrue="Send"
                                          Padding="0"
                                          BorderBrush="{DynamicResource ControlBorderBrush}"
                                          Style="{StaticResource ToggleButtonIconRoundTransparentAll}"
                                          Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}"
                                          Command="{Binding ElementName=window, Path=DataContext.TaskCheckedCommand}"
                                          CommandParameter="{Binding}"
                                          HorizontalAlignment="Right"
                                          Margin="0 0 2 0"
                                          Foreground="{DynamicResource ControlBackgroundBrush}"
                                          Content="Checked">
                                          <ToggleButton.ToolTip>
                                            <ToolTip
                                              Content="Send checked"
                                              Style="{StaticResource ToolTipContent}" />
                                          </ToggleButton.ToolTip>
                                        </ToggleButton>
                                      </StackPanel>
                                      <ProgressBar
                                        Visibility="{Binding IsProgress, Converter={StaticResource BoolConverter}}"
                                        Margin="5"
                                        HorizontalAlignment="Right"
                                        Width="20"
                                        Height="20"
                                        theme:UI.Thickness="2"
                                        Style="{StaticResource ProgressBarSpinner}"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="30" />
                                    </Grid>
                                  </Grid>
                                  <Grid
                                    VerticalAlignment="Top"
                                    Visibility="{Binding IsAssignedTo, Converter={StaticResource BoolConverterReverse}}"
                                    Grid.Row="0"
                                    Grid.Column="2">
                                    <Grid
                                      Visibility="{Binding StatusVisible, Converter={StaticResource BoolConverter}}">
                                      <StackPanel
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <ToggleButton
                                          Width="25"
                                          Height="25"
                                          theme:UI.IconWidth="20"
                                          theme:UI.IconHeight="20"
                                          Margin="5 0"
                                          theme:UI.IconFalse="Check"
                                          theme:UI.IconTrue="Check"
                                          Padding="0"
                                          BorderBrush="{DynamicResource ControlBorderBrush}"
                                          Style="{StaticResource ToggleButtonIconRoundTransparentAll}"
                                          Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}"
                                          Command="{Binding ElementName=window, Path=DataContext.TaskCompleteCommand}"
                                          CommandParameter="{Binding}"
                                          Foreground="{DynamicResource ControlBackgroundBrush}"
                                          Content="Complete">
                                          <ToggleButton.ToolTip>
                                            <ToolTip
                                              Content="Complete"
                                              Style="{StaticResource ToolTipContent}" />
                                          </ToggleButton.ToolTip>
                                        </ToggleButton>
                                        <ToggleButton
                                          Width="25"
                                          Height="25"
                                          theme:UI.IconWidth="20"
                                          theme:UI.IconHeight="20"
                                          theme:UI.IconFalse="Send"
                                          theme:UI.IconTrue="Send"
                                          Padding="0"
                                          BorderBrush="{DynamicResource ControlBorderBrush}"
                                          Style="{StaticResource ToggleButtonIconRoundTransparentAll}"
                                          Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}"
                                          Command="{Binding ElementName=window, Path=DataContext.TaskReCheckedCommand}"
                                          CommandParameter="{Binding}"
                                          Margin="0 0 2 0"
                                          Foreground="{DynamicResource ControlBackgroundBrush}"
                                          Content="ReChecked">
                                          <ToggleButton.ToolTip>
                                            <ToolTip
                                              Content="Send rechecked"
                                              Style="{StaticResource ToolTipContent}" />
                                          </ToggleButton.ToolTip>
                                        </ToggleButton>
                                      </StackPanel>
                                      <ProgressBar
                                        Visibility="{Binding IsProgress, Converter={StaticResource BoolConverter}}"
                                        Margin="5"
                                        HorizontalAlignment="Right"
                                        Width="20"
                                        Height="20"
                                        theme:UI.Thickness="2"
                                        Style="{StaticResource ProgressBarSpinner}"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="30" />
                                    </Grid>
                                  </Grid>
                                </Grid>
                                <StackPanel
                                  HorizontalAlignment="Left"
                                  Grid.Row="2">
                                  <StackPanel
                                    Visibility="{Binding IsAssignedTo, Converter={StaticResource BoolConverterReverse}}"
                                    Margin="0 0 0 5"
                                    Orientation="Horizontal">
                                    <TextBlock
                                      FontWeight="Bold"
                                      Text="AssignedTo : " />
                                    <TextBlock
                                      TextWrapping="Wrap"
                                      Text="{Binding User.Email}" />
                                  </StackPanel>
                                  <StackPanel
                                    Visibility="{Binding IsAssignedTo, Converter={StaticResource BoolConverter}}"
                                    Margin="0 0 0 5"
                                    Orientation="Horizontal">
                                    <TextBlock
                                      FontWeight="Bold"
                                      Text="AssignedBy : " />
                                    <TextBlock
                                      TextWrapping="Wrap"
                                      Text="{Binding CreateBy}" />
                                  </StackPanel>
                                </StackPanel>
                                <StackPanel
                                  Margin="0 0 0 5"
                                  VerticalAlignment="Bottom"
                                  Grid.Row="1"
                                  Grid.Column="0"
                                  Orientation="Horizontal">
                                  <TextBlock
                                    FontWeight="Bold"
                                    Text="Start : " />
                                  <TextBlock
                                    Text="{Binding DateStart , StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                                </StackPanel>
                                <StackPanel
                                  Margin="0 0 10 5"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Right"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Orientation="Horizontal">
                                  <TextBlock
                                    FontWeight="Bold"
                                    Text="End : " />
                                  <TextBlock
                                    Text="{Binding DateEnd , StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                                </StackPanel>
                                <Grid
                                  Grid.RowSpan="10"
                                  Visibility="{Binding FileAttachs.Count, Converter={StaticResource CountConverter}}"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Right">
                                  <Grid
                                    Visibility="{Binding IsAssignedTo, Converter={StaticResource BoolConverter}}">
                                    <Grid
                                      Visibility="{Binding AttachVisibleTo, Converter={StaticResource BoolConverter}}">
                                      <ToggleButton
                                        Content="{Binding FileAttachs.Count}"
                                        theme:UI.IconWidth="20"
                                        theme:UI.IconHeight="20"
                                        Visibility="{Binding IsProgressAttach, Converter={StaticResource BoolConverterReverse}}"
                                        Command="{Binding ElementName=window, Path=DataContext.TaskDownloadAttachCommand}"
                                        theme:UI.IconFalse="AttachFile"
                                        theme:UI.IconTrue="AttachFile"
                                        BorderThickness="0"
                                        Style="{StaticResource ToggleButtonRoundContent}"
                                        Width="25"
                                        Height="25"
                                        Margin="0 0 -2 2"
                                        Foreground="{DynamicResource PrimaryBackgroundBrush}"
                                        Background="{DynamicResource AccentBrush}">
                                        <ToggleButton.ToolTip>
                                          <ToolTip
                                            Background="{DynamicResource PrimaryBackgroundBrush}"
                                            BorderThickness="0">
                                            <StackPanel
                                              Margin="5">
                                              <TextBlock
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                Text="Attach:" />
                                              <ListBox
                                                Margin="0,5,0,0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding FileAttachs}" />
                                            </StackPanel>
                                          </ToolTip>
                                        </ToggleButton.ToolTip>
                                      </ToggleButton>
                                    </Grid>
                                  </Grid>
                                  <Grid
                                    Visibility="{Binding IsAssignedTo, Converter={StaticResource BoolConverterReverse}}">
                                    <Grid
                                      Visibility="{Binding AttachVisibleBy, Converter={StaticResource BoolConverter}}">
                                      <ToggleButton
                                        Content="{Binding FileAttachs.Count}"
                                        theme:UI.IconWidth="20"
                                        theme:UI.IconHeight="20"
                                        Visibility="{Binding IsProgressAttach, Converter={StaticResource BoolConverterReverse}}"
                                        Command="{Binding ElementName=window, Path=DataContext.TaskDownloadAttachCommand}"
                                        theme:UI.IconFalse="AttachFile"
                                        theme:UI.IconTrue="AttachFile"
                                        BorderThickness="0"
                                        Style="{StaticResource ToggleButtonRoundContent}"
                                        Width="25"
                                        Height="25"
                                        Margin="0 0 -2 2"
                                        Foreground="{DynamicResource PrimaryBackgroundBrush}"
                                        Background="{DynamicResource AccentBrush}">
                                        <ToggleButton.ToolTip>
                                          <ToolTip
                                            Background="{DynamicResource PrimaryBackgroundBrush}"
                                            BorderThickness="0">
                                            <StackPanel
                                              Margin="5">
                                              <TextBlock
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                Text="Attach:" />
                                              <ListBox
                                                Margin="0,5,0,0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding FileAttachs}" />
                                            </StackPanel>
                                          </ToolTip>
                                        </ToggleButton.ToolTip>
                                      </ToggleButton>
                                    </Grid>
                                  </Grid>
                                  <ProgressBar
                                    Visibility="{Binding IsProgressAttach, Converter={StaticResource BoolConverter}}"
                                    Margin="5"
                                    HorizontalAlignment="Right"
                                    Width="20"
                                    Height="20"
                                    theme:UI.Thickness="2"
                                    Style="{StaticResource ProgressBarSpinner}"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="30" />
                                </Grid>
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>
        </ListBox.GroupStyle>
      </ListBox>
      <Grid
        Margin="0 10"
        VerticalAlignment="Top">
        <ToggleButton
          BorderBrush="{DynamicResource PrimaryBorderBrush}"
          BorderThickness="1"
          Visibility="{Binding NMK_M.RoleVisible.VisibleMiddle}"
          Name="Assigned"
          Height="30"
          HorizontalAlignment="Left"
          Width="300"
          Style="{StaticResource ToggleButtonTwoContent}"
          VerticalAlignment="Center"
          IsChecked="{Binding NMK_M.IsAssignedTo}"
          Margin="10 0"
          theme:UI.ContentFalse="AssignedByMe"
          theme:UI.ContentTrue="AssignedToMe" />
      </Grid>
      <!--#region Controls-->
      <StackPanel
        Margin="10"
        VerticalAlignment="Top"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <CheckBox
