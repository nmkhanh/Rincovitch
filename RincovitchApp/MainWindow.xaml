            EventName="MouseLeftButtonDown">
            <i:InvokeCommandAction
              Command="{Binding ElementName=window,Path=DataContext.UserImageCommand}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
        <Grid>
          <Image
            Stretch="UniformToFill"
            Source="{Binding NMK_M.UserCurrent.Image}">
            <Image.Clip>
              <EllipseGeometry
                Center="95,95"
                RadiusX="95"
                RadiusY="95" />
            </Image.Clip>
          </Image>
        </Grid>
      </Border>
    </Grid>
    <!--#endregion-->
    <!--#region Leave-->
    <Grid
      Grid.Column="1"
      Visibility="{Binding ElementName=Leave, Path=IsChecked, Converter={StaticResource BoolConverter}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="*" />
        <ColumnDefinition
          Width="Auto" />
      </Grid.ColumnDefinitions>
      <ToggleButton
        Name="leave"
        Margin="10 10"
        Width="200"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        BorderBrush="{DynamicResource PrimaryBorderBrush}"
        BorderThickness="1"
        theme:UI.ContentFalse="Leave of me"
        theme:UI.ContentTrue="Leave of user"
        Style="{StaticResource ToggleButtonTwoContent}" />
      <Border
        Visibility="{Binding NMK_M.LeavesAssignToCollectionCount.Count, Converter={StaticResource CountConverter}}"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Width="20"
        Height="20"
        Margin="200 0 5 0"
        Background="{DynamicResource AccentBrush}"
        CornerRadius="10"
        IsHitTestVisible="False">
        <TextBlock
          Foreground="{DynamicResource PrimaryBackgroundBrush}"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Text="{Binding NMK_M.LeavesAssignToCollectionCount.Count}" />
      </Border>
      <StackPanel
        Visibility="{Binding ElementName=leave, Path=IsChecked, Converter={StaticResource BoolConverterReverse}}"
        Margin="210 10 0 0"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Orientation="Horizontal">
        <ToggleButton
          Style="{StaticResource ToggleButtonActiveProgress}"
          HorizontalAlignment="Right"
          Margin="10 0 0 0"
          Command="{Binding ElementName=window,Path=DataContext.LeaveAddCommand}"
          Width="100"
          Content="Add"
          theme:UI.IconFalse="Plus" />
        <ToggleButton
          Style="{StaticResource ToggleButtonActiveProgress}"
          HorizontalAlignment="Right"
          Margin="10 0"
          Command="{Binding ElementName=window,Path=DataContext.LeaveSaveCommand}"
          Width="100"
          Content="Save"
          theme:UI.IconFalse="DatabaseArrowUp" />
        <ToggleButton
          Style="{StaticResource ToggleButtonActiveProgress}"
          HorizontalAlignment="Right"
          Command="{Binding ElementName=window,Path=DataContext.LeaveSendCommand}"
          Width="100"
          Content="Send"
          theme:UI.IconFalse="EmailOutline" />
      </StackPanel>
      <StackPanel
        Visibility="{Binding ElementName=leave, Path=IsChecked, Converter={StaticResource BoolConverterReverse}}"
        Margin="0 40 0 10">
        <DataGrid
          Margin="0 10"
          ItemsSource="{Binding NMK_M.LeavesCollection}">
          <DataGrid.RowStyle>
            <Style
              TargetType="DataGridRow"
              BasedOn="{StaticResource DataGridRowDefault}">
              <Setter
                Property="Background"
                Value="{Binding Background}" />
              <Setter
                Property="DetailsVisibility"
                Value="{Binding ApprovalStatusAssign, Converter={StaticResource BoolConverter}}" />
              <Setter
                Property="IsEnabled"
                Value="{Binding ApprovalStatus}" />
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn
              Width="30">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox
                    HorizontalAlignment="Center"
                    IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn
              Header="Type"
              Width="250">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox
                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                    Padding="0"
                    Style="{StaticResource ComboBoxTransparentAnyAll}"
                    Margin="10 0"
                    IsSynchronizedWithCurrentItem="False"
                    SelectedValue="{Binding LeaveType, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding LeaveTypeList}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn
              Header="Reason"
              Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBox
                    BorderThickness="0"
                    Style="{StaticResource TextBoxTransparent}"
                    VerticalAlignment="Center"
                    Text="{Binding LeaveReason, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn
              Visibility="{Binding ElementName=window,Path=DataContext.NMK_M.LeaveChooseDayVisible}"
              Header="SendTo"
              Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox
                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                    Padding="0"
                    Style="{StaticResource ComboBoxTransparentAnyAll}"
                    DisplayMemberPath="Name"
                    IsEditable="True"
                    Margin="10 0"
                    IsSynchronizedWithCurrentItem="False"
                    SelectedValue="{Binding User, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding ElementName=window, Path=DataContext.NMK_M.UsersCollectionLeave}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn
              Visibility="{Binding ElementName=window,Path=DataContext.NMK_M.LeaveChooseDayVisible}"
              Header="Cc"
              Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox
                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                    Padding="0"
                    Style="{StaticResource ComboBoxTransparentAnyAll}"
                    DisplayMemberPath="Name"
                    IsEditable="True"
                    Margin="10 0"
                    IsSynchronizedWithCurrentItem="False"
                    SelectedValue="{Binding UserCC, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding ElementName=window, Path=DataContext.NMK_M.UsersCollectionLeave}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn
              Header="Day"
              Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <icon:MaterialIcon
                      Margin="8 0 0 0"
                      HorizontalAlignment="Left"
                      Width="29"
                      Height="29"
                      Visibility="{Binding ApprovalStatusAssign, Converter={StaticResource BoolConverterReverse}}"
                      Kind="CheckCircleOutline"
                      Foreground="Green" />
                    <StackPanel
                      Visibility="{Binding ApprovalStatusAssign, Converter={StaticResource BoolConverter}}"
                      Orientation="Horizontal">
                      <ToggleButton
                        Name="chooseday"
                        ToolTip="Choose day"
                        Command="{Binding ElementName=window, Path=DataContext.LeaveChooseDayCommand}"
                        CommandParameter="{Binding}"
                        Margin="10 0 0 0"
                        Width="25"
                        Height="25"
                        theme:UI.IconWidth="20"
                        theme:UI.IconHeight="20"
                        theme:UI.IconFalse="Select"
                        theme:UI.IconTrue="Select"
                        Style="{StaticResource ToggleButtonRound}" />
                      <Grid>
                        <ToggleButton
                          Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}"
                          ToolTip="Remove"
                          Command="{Binding ElementName=window, Path=DataContext.LeaveDeleteCommand}"
                          CommandParameter="{Binding}"
                          Margin="5 0"
                          Width="25"
                          Height="25"
                          theme:UI.IconWidth="20"
                          theme:UI.IconHeight="20"
                          theme:UI.IconFalse="Close"
                          theme:UI.IconTrue="Close"
                          Style="{StaticResource ToggleButtonRound}" />
                        <ProgressBar
                          Margin="5 0"
                          theme:UI.Thickness="2"
                          x:Name="Progress"
                          Width="25"
                          Height="25"
                          IsIndeterminate="True"
                          Visibility="{Binding IsProgress, Converter={StaticResource BoolConverter}}"
                          Style="{StaticResource ProgressBarSpinner}" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
          <DataGrid.RowDetailsTemplate>
            <DataTemplate>
              <ListBox
                Background="White"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource ListBoxItemTransparent}"
                ItemsSource="{Binding LeaveListCollectionView}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel
                      Margin="40 0 0 0"
                      Height="40"
                      Orientation="Horizontal">
                      <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding LeaveStart,StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                      <TextBlock
                        Margin="5 0"
                        VerticalAlignment="Center"
                        Text="-" />
                      <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding LeaveEnd,StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                      <TextBlock
                        Margin="50 0 0 0"
                        VerticalAlignment="Center"
                        Text="From : " />
                      <TextBox
                        TextAlignment="Center"
                        Padding="0"
                        theme:UI.Hint="HH"
                        Width="50"
                        Margin="10 0"
                        VerticalAlignment="Center"
                        Text="{Binding StartH}" />
                      <TextBox
                        Width="50"
                        TextAlignment="Center"
                        Padding="0"
                        theme:UI.Hint="MM"
                        Margin="0 0"
                        VerticalAlignment="Center"
                        Text="{Binding StartM}" />
                      <TextBlock
                        Margin="10 0 0 0"
                        VerticalAlignment="Center"
                        Text="To : " />
                      <TextBox
                        Width="50"
                        TextAlignment="Center"
                        Padding="0"
                        theme:UI.Hint="HH"
                        Margin="10 0"
                        VerticalAlignment="Center"
                        Text="{Binding EndH}" />
                      <TextBox
                        Width="50"
                        TextAlignment="Center"
                        Padding="0"
                        theme:UI.Hint="MM"
                        Margin="0 0"
                        VerticalAlignment="Center"
                        Text="{Binding EndM}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>
      </StackPanel>
      <Grid
        Grid.Column="1"
        Visibility="{Binding ElementName=leave, Path=IsChecked, Converter={StaticResource BoolConverterReverse}}">
        <StackPanel
          Margin="0 00 0 10"
          Visibility="{Binding NMK_M.LeaveChooseDay, Converter={StaticResource BoolConverter}}">
          <Grid>
            <Border
              Margin="10 0"
              CornerRadius="5"
              Height="30"
              VerticalAlignment="Center"
              HorizontalAlignment="Left"
              Background="{Binding NMK_M.LeaveSelect.Background}">
              <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <TextBlock
                  FontWeight="Bold"
                  VerticalAlignment="Center"
                  Margin="10 0 0 0"
                  HorizontalAlignment="Left"
                  Text="Selected : " />
                <TextBlock
                  Margin="0 0 10 0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Text="{Binding NMK_M.LeaveSelect.LeaveReason, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Border>
            <StackPanel
              HorizontalAlignment="Right"
              Margin="0 10"
              Orientation="Horizontal">
              <TextBox
                Width="80"
                theme:UI.Hint="Month"
                Text="{Binding NMK_M.FilterMonthLeave, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox
                IsEnabled="False"
                Width="80"
                theme:UI.Hint="Year"
                Margin="10 0"
                Text="{Binding NMK_M.FilterYearLeave, UpdateSourceTrigger=PropertyChanged}" />
              <ToggleButton
                Command="{Binding ElementName=window, Path=DataContext.LeaveChooseDayCloseCommand}"
                Margin="0 0 10 0"
                Width="25"
                Height="25"
                theme:UI.IconWidth="20"
                theme:UI.IconHeight="20"
                theme:UI.IconFalse="Close"
                theme:UI.IconTrue="Close"
                Style="{StaticResource ToggleButtonRound}" />
            </StackPanel>
          </Grid>
          <StackPanel
            Margin="10 0"
            Orientation="Horizontal">
            <Border
              Width="101"
              Height="30"
              Background="{DynamicResource ControlBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1,1,1,1">
              <TextBlock
                Text="Monday"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </Border>
            <Border
              Width="100"
              Height="30"
              Background="{DynamicResource ControlBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="0,1,1,1">
              <TextBlock
                Text="Tuesday"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </Border>
            <Border
              Width="100"
              Height="30"
              Background="{DynamicResource ControlBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="0,1,1,1">
              <TextBlock
                Text="Wednesday"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </Border>
            <Border
              Width="100"
              Height="30"
              Background="{DynamicResource ControlBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="0,1,1,1">
              <TextBlock
                Text="Thursday"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </Border>
            <Border
              Width="100"
              Height="30"
              Background="{DynamicResource ControlBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="0,1,1,1">
              <TextBlock
                Text="Friday"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </Border>
          </StackPanel>
          <ItemsControl
            Margin="10 0"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1,0,0,0"
            ItemsSource="{Binding NMK_M.DaysLeaves.Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid
                  HorizontalAlignment="Left"
                  Columns="5" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border
                  Width="100"
                  Height="100"
                  Background="{DynamicResource ControlBackgroundBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="0,0,1,1">
                  <Grid
                    IsEnabled="{Binding Leave.ApprovalStatus}">
                    <ToggleButton
                      Command="{Binding ElementName=window, Path=DataContext.LeaveCheckCommand}"
                      CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}}"
                      IsChecked="{Binding IsChecked}"
                      theme:UI.BDCorner="0"
                      BorderThickness="0"
                      Width="Auto"
                      Height="Auto">
                      <TextBlock
                        Text="{Binding Name, StringFormat='{}{0:dd}'}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                      <ToggleButton.Style>
                        <Style
                          TargetType="ToggleButton"
                          BasedOn="{StaticResource BaseToggleButton}">
                          <Style.Triggers>
                            <Trigger
                              Property="IsChecked"
                              Value="True">
                              <Setter
                                Property="Background"
                                Value="{Binding Leave.Background}" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock
                      Margin="10"
                      Text="{Binding Holiday.LocalName}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
      <Grid
        Visibility="{Binding ElementName=leave, Path=IsChecked, Converter={StaticResource BoolConverter}}"
        Margin="0 50 0 0"
        Grid.ColumnSpan="3">
        <DataGrid
          Visibility="{Binding NMK_M.RoleVisible.VisibleLeader}"
          Style="{StaticResource DataGridTransparentNotifies}"
          RowHeight="40"
          ItemsSource="{Binding NMK_M.LeavesAssignToCollection}">
          <DataGrid.RowStyle>
            <Style
              TargetType="DataGridRow"
              BasedOn="{StaticResource DataGridRowDefault}">
              <Setter
                Property="DetailsVisibility"
                Value="{Binding ApprovalStatusAssign, Converter={StaticResource BoolConverter}}" />
              <!--<Setter
                Property="IsEnabled"
                Value="{Binding ApprovalStatusAssign}" />-->
              <Setter
                Property="ToolTip">
                <Setter.Value>
                  <ListBox
                    Visibility="{Binding ApprovalStatusAssign, Converter={StaticResource BoolConverterReverse}}"
                    Background="White"
                    BorderThickness="0"
                    ItemsSource="{Binding LeaveListCollectionView}">
                    <ListBox.ItemContainerStyle>
                      <Style
                        TargetType="ListBoxItem"
                        BasedOn="{StaticResource ListBoxItemTransparent}">
                        <Setter
                          Property="Width"
                          Value="1000" />
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel
                          Margin="10 0 0 0"
                          Height="40"
                          Orientation="Horizontal">
                          <TextBlock
                            Margin="5 0 0 0"
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            Text="(" />
                          <TextBlock
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            Text="{Binding Percent}" />
                          <TextBlock
                            Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            Text="%)" />
                          <TextBlock
                            Margin="5 0"
                            VerticalAlignment="Center"
                            Text="-" />
                          <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding LeaveStart,StringFormat='{}{0:[dddd] - dd/MM/yyyy HH:mm}'}" />
                          <TextBlock
                            Margin="5 0"
                            VerticalAlignment="Center"
                            Text="-" />
                          <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding LeaveEnd,StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                          <TextBlock
                            Margin="5 0"
                            VerticalAlignment="Center"
                            Text="-" />
                          <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding UsersList}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Setter.Value>
              </Setter>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.RowDetailsTemplate>
            <DataTemplate>
              <ListBox
                Background="White"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource ListBoxItemTransparent}"
                ItemsSource="{Binding LeaveListCollectionView}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel
                      Margin="10 0 0 0"
                      Height="40"
                      Orientation="Horizontal">
                      <TextBlock
                        Margin="5 0 0 0"
                        Foreground="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center"
                        Text="(" />
                      <TextBlock
                        Foreground="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center"
                        Text="{Binding Percent}" />
                      <TextBlock
                        Foreground="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center"
                        Text="%)" />
                      <TextBlock
                        Margin="5 0"
                        VerticalAlignment="Center"
                        Text="-" />
                      <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding LeaveStart,StringFormat='{}{0:[dddd] - dd/MM/yyyy HH:mm}'}" />
                      <TextBlock
                        Margin="5 0"
                        VerticalAlignment="Center"
                        Text="-" />
                      <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding LeaveEnd,StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                      <TextBlock
                        Margin="5 0"
                        VerticalAlignment="Center"
                        Text="-" />
                      <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding UsersList}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
          <DataGrid.Columns>
            <DataGridTemplateColumn
              Header="Message"
              Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ToggleButton
                    Height="Auto"
                    Padding="0"
                    theme:UI.PaddingContent="0"
                    Style="{StaticResource ToggleButtonTransparentAll}"
                    Margin="10 0"
                    VerticalAlignment="Center">
                    <StackPanel
                      Orientation="Horizontal">
                      <TextBlock
                        FontWeight="Bold"
                        Text="{Binding LeaveType}" />
                      <TextBlock
                        FontWeight="Bold"
                        Text=" : " />
                      <TextBlock
                        FontWeight="{Binding FontWeight}"
                        TextWrapping="Wrap"
                        Text="{Binding LeaveReason}" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn
              Header="CreateBy"
              Width="250">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock
                    FontWeight="{Binding FontWeight}"
                    Margin="10 0"
                    VerticalAlignment="Center"
                    Text="{Binding UserCreateBy.Email}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn
              Header="CreateAt"
              Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock
                    FontWeight="{Binding FontWeight}"
                    Margin="10 0"
                    VerticalAlignment="Center"
                    Text="{Binding CreateAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn
              Header="Last modify"
              Width="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel
                    Orientation="Horizontal">
                    <TextBlock
                      FontWeight="{Binding FontWeight}"
                      Margin="10 0"
                      VerticalAlignment="Center"
                      Text="{Binding UpdateAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                    <icon:MaterialIcon
                      Width="30"
                      Height="30"
                      Visibility="{Binding ApprovalStatusAssign, Converter={StaticResource BoolConverterReverse}}"
                      Kind="CheckCircleOutline"
                      Foreground="Green" />
                    <Grid
                      Visibility="{Binding IsProgress, Converter={StaticResource BoolConverterReverse}}">
                      <ToggleButton
                        Command="{Binding ElementName=window, Path=DataContext.LeaveApprovedCommand}"
                        CommandParameter="{Binding}"
                        ToolTip="Approved"
                        Width="25"
                        Height="25"
                        Visibility="{Binding ApprovalStatusAssign, Converter={StaticResource BoolConverter}}"
                        Style="{StaticResource ToggleButtonRound}"
                        theme:UI.IconFalse="Check"
                        theme:UI.IconTrue="Check" />
                    </Grid>
                    <ProgressBar
                      theme:UI.Thickness="2"
                      x:Name="Progress"
                      Width="25"
                      Height="25"
                      IsIndeterminate="True"
                      Visibility="{Binding IsProgress, Converter={StaticResource BoolConverter}}"
                      Style="{StaticResource ProgressBarSpinner}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
    <!--#endregion-->
    <!--#region Message-->
    <Grid
      Grid.ColumnSpan="10"
      Grid.RowSpan="10">
      <ContentControl
        DataContext="{Binding NMK_M.DialogMessage}"
        Visibility="{Binding Show, Converter={StaticResource BoolConverter}}"
        Template="{StaticResource DialogMessageTemplate}" />
    </Grid>
    <!--#endregion-->
    <!--#region Progress-->
    <Grid
      Grid.ColumnSpan="10"
      Grid.RowSpan="10">
      <ProgressBar
        theme:UI.Thickness="4"
        IsIndeterminate="True"
        Visibility="{Binding ElementName=window,Path=DataContext.NMK_M.IsLoading, Converter={StaticResource BoolConverter}}"
        Style="{StaticResource BackgroundProgressBarSpinner}" />
    </Grid>
    <!--#endregion-->
  </Grid>
</Window>

  