	<Style
		x:Key="DataGridColumnHeaderDefault"
		TargetType="DataGridColumnHeader">
		<Setter
			Property="Padding"
			Value="10 0 0 0" />
		<Setter
			Property="Height"
			Value="30" />
		<Setter
			Property="BorderThickness"
			Value="0,0,0,0" />
		<Setter
			Property="BorderBrush"
      Value="{DynamicResource ControlBorderBrush}" />
		<Setter
			Property="Background"
			Value="{DynamicResource ControlBackgroundBrush}" />
		<Setter
			Property="Foreground"
      Value="{DynamicResource ControlForegroundBrush}" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Left" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Style.Triggers>
			<Trigger
				Property="SortDirection"
				Value="Ascending">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<StackPanel
								Orientation="Horizontal">
								<TextBlock
									Text="{Binding}"
									VerticalAlignment="Center" />
								<icon:MaterialIcon
									Kind="ArrowDown"
									Width="20"
									Height="20" />
							</StackPanel>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
			<Trigger
				Property="SortDirection"
				Value="Descending">
				<Setter
					Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<StackPanel
								Orientation="Horizontal">
								<TextBlock
									Text="{Binding}"
									VerticalAlignment="Center" />
								<icon:MaterialIcon
									Kind="ArrowUp"
									Width="20"
									Height="20" />
							</StackPanel>
						</DataTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
	</Style>
