<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
	xmlns:theme="clr-namespace:RincovitchApp.UITheme">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="pack://application:,,,/RincovitchApp;component/UITheme/LightTheme.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<Style
		x:Key="DataGridCellDefault"
		TargetType="DataGridCell">
		<Setter
			Property="Padding"
			Value="10 0 0 0" />
		<Setter
			Property="BorderThickness"
			Value="0,0,0,1" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource ControlBorderBrush}" />
		<Setter
			Property="VerticalAlignment"
			Value="Stretch" />
		<Setter
			Property="HorizontalAlignment"
			Value="Stretch" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="HorizontalContentAlignment"
			Value="Left" />
		<Setter
			Property="Background"
			Value="Transparent" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource ControlForegroundBrush}" />
		<Setter
			Property="Focusable"
			Value="False" />
	</Style>
