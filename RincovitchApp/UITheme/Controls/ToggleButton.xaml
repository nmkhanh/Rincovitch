<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:ei="http://schemas.microsoft.com/xaml/behaviors/2010"
  xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
  xmlns:theme="clr-namespace:RincovitchApp.UITheme"
  xmlns:command="clr-namespace:RincovitchApp.UITheme">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/LightTheme.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/RadioButton.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/ProgressBar.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Converter.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <!-- #region ToggleButtonVertical -->
  <Style
    x:Key="ToggleButtonVertical"
    TargetType="ToggleButton">
    <Setter
      Property="FontSize"
      Value="10" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="theme:UI.PaddingContent"
      Value="0 0 0 10" />
    <Setter
      Property="Padding"
      Value="0 0" />
    <Setter
      Property="Height"
      Value="60" />
    <Setter
      Property="Width"
      Value="60" />
    <Setter
      Property="theme:UI.IconHeight"
      Value="24" />
    <Setter
      Property="theme:UI.IconWidth"
      Value="24" />
    <Setter
      Property="HorizontalContentAlignment"
      Value="Center" />
    <Setter
      Property="theme:UI.BDCorner"
      Value="0" />
    <Setter
      Property="BorderThickness"
      Value="1" />
    <Setter
      Property="BorderBrush"
      Value="Transparent" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource ControlForegroundBrush}" />
    <Setter
      Property="CommandParameter"
      Value="{Binding}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ToggleButton">
          <Border
            Padding="{TemplateBinding Padding}"
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.BDCorner)}">
            <StackPanel
              VerticalAlignment="Center"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
              <Grid
                Margin="0 10 0 5">
                <icon:MaterialIcon
                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconTrue), Converter={StaticResource NullConverter}}"
                  Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconWidth)}"
                  Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconHeight)}"
                  Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconTrue)}" />
                <icon:MaterialIcon
                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconFalse), Converter={StaticResource NullConverter}}"
                  Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconWidth)}"
                  Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconHeight)}"
                  Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconFalse)}" />
              </Grid>
              <ContentPresenter
                Content="{TemplateBinding Content}"
                Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.PaddingContent) }"
                VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                Property="Background"
                Value="{DynamicResource ControlHoverBackgroundBrush}" />
            </Trigger>
            <Trigger
              Property="IsEnabled"
              Value="False">
              <Setter
                Property="Background"
                Value="{DynamicResource ControlDisabledBackgroundBrush}" />
              <Setter
                Property="BorderBrush"
                Value="{DynamicResource ControlDisabledBorderBrush}" />
            </Trigger>
            <!--<Trigger
              Property="IsChecked"
              Value="True">
              <Setter
                Property="Background"
                Value="{DynamicResource ControlSelectedBackgroundBrush}" />
              <Setter
                Property="Foreground"
                Value="{DynamicResource AccentBrush}" />
            </Trigger>-->
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- #endregion -->
