  <!-- #region ToggleButtonIconRoundPopupAccount -->
  <Style
    BasedOn="{StaticResource ToggleButtonIconRoundTransparent}"
    TargetType="ToggleButton"
    x:Key="ToggleButtonIconRoundPopupAccount">
    <Setter
      Property="theme:UI.BDCorner"
      Value="4" />
    <Setter
      Property="Height"
      Value="60" />
    <Setter
      Property="Width"
      Value="60" />
    <Setter
      Property="theme:UI.IconWidth"
      Value="24" />
    <Setter
      Property="theme:UI.IconHeight"
      Value="24" />
    <Setter
      Property="theme:UI.Icon"
      Value="AccountCircleOutline" />
    <Setter
      Property="CommandParameter"
      Value="{Binding}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ToggleButton">
          <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="0"
            Padding="{TemplateBinding Padding}">
            <Grid>
              <icon:MaterialIcon
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconWidth)}"
                Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconHeight)}"
                Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.Icon)}" />
              <Popup
                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                x:Name="PART_Popup"
                Placement="Right"
                IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                StaysOpen="False"
                AllowsTransparency="True"
                Focusable="False"
                PopupAnimation="None">
                <Border
                  CornerRadius="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(theme:UI.BDCorner)}"
                  Background="{DynamicResource PrimaryBackgroundBrush}"
                  BorderBrush="{DynamicResource PrimaryBorderBrush}"
                  BorderThickness="1"
                  Margin="1 0 0 0">
                  <StackPanel
                    MinWidth="200">
                    <Grid>
                      <Image
                        Width="40"
                        Height="40">
                        <Image.Clip>
                          <EllipseGeometry
                            Center="20 20"
                            RadiusX="20"
                            RadiusY="20" />
                        </Image.Clip>
                      </Image>
                      <StackPanel
                        VerticalAlignment="Center"
                        Margin="50 0 10 0">
                        <TextBlock
                          Text="asdasfasf" />
                        <TextBlock
                          Text="asdasfasf" />
                      </StackPanel>
                    </Grid>
                    <Separator />
                    <ToggleButton
                      Style="{StaticResource ToggleButtonTransparent}"
                      IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolReverseConverter}}"
                      theme:UI.BDCorner="0"
                      theme:UI.IconFalse="HelpCircle"
                      Content="Help"
                      Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(command:AttachedBehavior.HelpCommand)}"
                      CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DataContext}" />
                    <ToggleButton
                      Style="{StaticResource ToggleButtonTransparent}"
                      IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolReverseConverter}}"
                      theme:UI.BDCorner="0"
                      theme:UI.IconFalse="Settings"
                      Content="Accounts"
                      Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(command:AttachedBehavior.AccountsCommand)}"
                      CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DataContext}" />
                    <Separator />
                    <TextBlock
                      Margin="10 10 0 5"
                      Text="Theme" />
                    <RadioButton
                      Margin="20 0 0 0"
                      Style="{StaticResource RadioButtonThemeStyle}"
