						<!-- Nội dung nhập -->
						<ScrollViewer
							x:Name="PART_ContentHost"
							VerticalAlignment="Center"
							VerticalScrollBarVisibility="Auto"
							Height="{TemplateBinding Height}" />
						<!-- Clear Button -->
            <!--<Button
              VerticalAlignment="Center"
              Grid.Column="1"
              x:Name="PART_ClearButton"
              Style="{DynamicResource ButtonIconRound}"
              theme:UI.Icon="Close"
              Width="{TemplateBinding Height}"
              Height="{TemplateBinding Height}"
              BorderBrush="Transparent"
              Visibility="{TemplateBinding Text, Converter={StaticResource HasValueConverter}}"/>-->
            <!-- Search Button -->
            <ToggleButton
              theme:UI.PaddingContent ="0"
              Padding="0"
              Grid.Column="2"
              x:Name="PART_SearchButton"
              theme:UI.IconFalse="Search"
              Width="{TemplateBinding Height}"
              Height="{TemplateBinding Height}"
              BorderBrush="Transparent"
              Command="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(theme:AttachedBehavior.ClickCommand)}" />
          </Grid>
					<!-- Triggers -->
					<ControlTemplate.Triggers>
						<Trigger
							Property="IsFocused"
							Value="True">
							<Setter
