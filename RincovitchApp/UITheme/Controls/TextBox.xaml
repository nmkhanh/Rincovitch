<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
	xmlns:theme="clr-namespace:RincovitchApp.UITheme">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary
			Source="pack://application:,,,/RincovitchApp;component/UITheme/LightTheme.xaml"/>
		<ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/ToggleButton.xaml" />
		<ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Converter.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<Style
		TargetType="TextBox">
    <Setter
      Property="IsUndoEnabled"
      Value="False" />
    <Setter
			Property="Height"
			Value="30" />
		<Setter
			Property="BorderBrush"
			Value="{DynamicResource ControlBorderBrush}" />
		<Setter
			Property="Background"
			Value="{DynamicResource ControlBackgroundBrush}" />
		<Setter
			Property="Foreground"
			Value="{DynamicResource ControlForegroundBrush}" />
		<Setter
			Property="CaretBrush"
			Value="{DynamicResource ControlForegroundBrush}" />
		<Setter
			Property="Padding"
			Value="10 0 10 0" />
		<Setter
			Property="VerticalContentAlignment"
			Value="Center" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="TextBox">
					<Grid
						Visibility="{TemplateBinding Visibility}">
						<!-- TextBox nền -->
						<Border
							Grid.ColumnSpan="5"
							x:Name="Bd"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.BDCorner)}" />
						<!-- Placeholder / Hint -->
						<TextBlock
							x:Name="HintText"
							Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.Hint)}"
							Foreground="{DynamicResource SecondaryForegroundBrush}"
							Margin="{TemplateBinding Padding}"
							VerticalAlignment="Center"
							IsHitTestVisible="False"
							Visibility="{TemplateBinding Text, Converter={StaticResource HasValueConverterReverse}}" />
            <!-- Placeholder / Hint -->
            <TextBlock
              HorizontalAlignment="Left"
              Background="{TemplateBinding Background}"
              Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.Hint)}"
              Foreground="{DynamicResource SecondaryForegroundBrush}"
              Margin="10 -30 10 0"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              Visibility="{TemplateBinding Text, Converter={StaticResource HasValueConverter}}" />
            <!-- Nội dung nhập -->
						<ScrollViewer
							x:Name="PART_ContentHost"
							VerticalAlignment="Center"
							VerticalScrollBarVisibility="Auto"
							Height="{TemplateBinding Height}" />
					</Grid>
					<!-- Triggers -->
					<ControlTemplate.Triggers>
						<Trigger
							Property="IsFocused"
							Value="True">
							<Setter
								TargetName="Bd"
								Property="BorderBrush"
								Value="{DynamicResource ControlHoverBorderBrush}" />
						</Trigger>
						<Trigger
							Property="IsMouseOver"
							Value="True">
							<Setter
								TargetName="Bd"
								Property="BorderBrush"
                Value="{DynamicResource ControlHoverBorderBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
