  <!-- #region RadioButtonIconContentVerticalStyle -->
  <Style
    TargetType="RadioButton"
    x:Key="RadioButtonIconContentVerticalStyle">
    <Setter
      Property="FontSize"
      Value="10" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="theme:UI.IconWidth"
      Value="24" />
    <Setter
      Property="theme:UI.IconHeight"
      Value="24" />
    <Setter
      Property="Height"
      Value="60" />
    <Setter
      Property="Width"
      Value="60" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource ControlForegroundBrush}" />
    <Setter
      Property="CommandParameter"
      Value="{Binding}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="RadioButton">
          <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}">
            <StackPanel>
              <icon:MaterialIcon
                Margin="0 10 0 5"
                Width="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(theme:UI.IconWidth)}"
                Height="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(theme:UI.IconHeight)}"
                Kind="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(theme:UI.Icon)}" />
              <ContentPresenter
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="{DynamicResource ControlHoverBackgroundBrush}" />
            </Trigger>
            <Trigger
              Property="IsChecked"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="{DynamicResource ControlSelectedBackgroundBrush}" />
            </Trigger>
            <!--<Trigger
							Property="IsChecked"
							Value="False">
							<Setter
								Property="Foreground"
								Value="{DynamicResource BGControlSecondaryColorSelected}" />
						</Trigger>-->
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- #endregion -->
  <!-- #region RadioButtonIconContentHorizontalStyle -->
  <Style
    TargetType="RadioButton"
    x:Key="RadioButtonIconContentHorizontalStyle">
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="Height"
      Value="30" />
    <Setter
      Property="Width"
      Value="Auto" />
    <Setter
      Property="theme:UI.IconWidth"
      Value="20" />
    <Setter
      Property="theme:UI.IconHeight"
      Value="20" />
    <Setter
      Property="HorizontalContentAlignment"
      Value="Left" />
    <Setter
      Property="VerticalContentAlignment"
      Value="Center" />
    <Setter
      Property="Padding"
      Value="10 0 10 0" />
    <Setter
      Property="BorderBrush"
      Value="Transparent" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource ControlForegroundBrush}" />
    <Setter
      Property="CommandParameter"
      Value="{Binding}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="RadioButton">
          <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.BDCorner)}"
            Padding="{TemplateBinding Padding}">
            <StackPanel
              Orientation="Horizontal"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
              <icon:MaterialIcon
                Margin="0 0 10 0"
                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconWidth)}"
                Height="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(theme:UI.IconHeight)}"
                Kind="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(theme:UI.Icon)}" />
              <ContentPresenter
                VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="{DynamicResource ControlHoverBackgroundBrush}" />
            </Trigger>
            <Trigger
              Property="IsChecked"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="{DynamicResource ControlSelectedBackgroundBrush}" />
            </Trigger>
            <Trigger
              Property="IsEnabled"
              Value="False">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="{DynamicResource ControlDisabledBackgroundBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- #endregion -->
  <!-- #region RadioButtonThemeStyle -->
  <Style
    TargetType="RadioButton"
    x:Key="RadioButtonThemeStyle">
    <Setter
      Property="Height"
      Value="30" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource ControlForegroundBrush}" />
    <Setter
      Property="Padding"
      Value="10 0 10 0" />
    <Setter
      Property="CommandParameter"
      Value="{Binding}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="RadioButton">
          <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="Auto" />
                <ColumnDefinition
                  Width="*" />
              </Grid.ColumnDefinitions>
              <Border
                x:Name="Stick"
                Background="Transparent"
                Width="8"
                Height="8"
                CornerRadius="10"
                Margin="0 0 5 0" />
              <ContentPresenter
                Grid.Column="1"
                VerticalAlignment="Center"
                Margin="{TemplateBinding Padding}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="{DynamicResource ControlHoverBackgroundBrush}" />
            </Trigger>
            <Trigger
              Property="IsChecked"
              Value="True">
              <!--<Setter
								TargetName="Bd"
								Property="Background"
								Value="{DynamicResource BGControlPrimaryColorSelected}" />-->
              <Setter
                TargetName="Stick"
                Property="Background"
                Value="{DynamicResource ControlForegroundBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- #endregion -->
  <!-- #region RadioButtonBottomLineStyle -->
  <Style
    x:Key="RadioButtonBottomLineStyle"
    TargetType="RadioButton">
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="Height"
      Value="30" />
    <Setter
      Property="Width"
      Value="80" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource ControlForegroundBrush}" />
    <Setter
      Property="CommandParameter"
      Value="{Binding}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="RadioButton">
          <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition
                  Height="*" />
                <RowDefinition
                  Height="Auto" />
              </Grid.RowDefinitions>
              <ContentPresenter
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
              <Border
                Grid.Row="1"
                x:Name="Stick"
                Background="Transparent"
                Width="{TemplateBinding Width}"
                Height="4"
                CornerRadius="2" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="Transparent" />
            </Trigger>
            <Trigger
              Property="IsChecked"
              Value="True">
              <Setter
                TargetName="Bd"
                Property="Background"
                Value="Transparent" />
              <Setter
                TargetName="Stick"
                Property="Background"
                Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- #endregion -->
  <!-- #region RadioButtonRound -->
  <Style
    TargetType="RadioButton"
    x:Key="RadioButtonRound">
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="Height"
      Value="30" />
    <Setter
      Property="Width"
      Value="30" />
    <Setter
      Property="theme:UI.IconWidth"
      Value="20" />
    <Setter
      Property="theme:UI.IconHeight"
      Value="20" />
    <Setter
      Property="BorderBrush"
      Value="Transparent" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource ControlForegroundBrush}" />
    <Setter
      Property="CommandParameter"
      Value="{Binding}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="RadioButton">
          <Border
            x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Height}"
            Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid
                Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconTrue), Converter={StaticResource NullConverter}}">
                <icon:MaterialIcon
                  Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconWidth)}"
                  Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconHeight)}"
                  Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconTrue)}"
                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" />
              </Grid>
              <Grid
                Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconFalse), Converter={StaticResource NullConverter}}">
                <icon:MaterialIcon
                  Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconWidth)}"
                  Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconHeight)}"
                  Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(theme:UI.IconFalse)}"
                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverterReverse}}" />
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                Property="Background"
                Value="Transparent" />
            </Trigger>
            <Trigger
              Property="IsEnabled"
              Value="False">
              <Setter
                Property="Background"
                Value="{DynamicResource ControlDisabledBackgroundBrush}" />
              <Setter
                Property="BorderBrush"
                Value="{DynamicResource ControlDisabledBorderBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- #endregion -->
</ResourceDictionary>