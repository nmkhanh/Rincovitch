<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:ei="http://schemas.microsoft.com/xaml/behaviors/2010"
  xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
  xmlns:theme="clr-namespace:RincovitchApp.UITheme"
  xmlns:command="clr-namespace:RincovitchApp.UITheme">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/LightTheme.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/TextBox.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/RadioButton.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/ToggleButton.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/ProgressBar.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/ListBox.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/ListBoxItem.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/TreeView.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Controls/TreeViewItem.xaml" />
    <ResourceDictionary
      Source="pack://application:,,,/RincovitchApp;component/UITheme/Converter.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <!--#region Grid-->
  <Style
    x:Key="DialogOverlayStyle"
    TargetType="Grid">
    <Setter
      Property="Background"
      Value="{DynamicResource PrimaryBackgroundBrush}" />
    <Setter
      Property="Panel.ZIndex"
      Value="999" />
  </Style>
  <!--#endregion-->
  <!--#region Border-->
  <Style
    x:Key="DialogContainerStyle"
    TargetType="Border">
    <Setter
      Property="Background"
      Value="{DynamicResource PrimaryBackgroundBrush}" />
    <Setter
      Property="BorderBrush"
      Value="{DynamicResource ControlBorderBrush}" />
    <Setter
      Property="BorderThickness"
      Value="1" />
    <Setter
      Property="CornerRadius"
      Value="4" />
    <Setter
      Property="MinWidth"
      Value="300" />
    <Setter
      Property="MinHeight"
      Value="100" />
    <Setter
      Property="HorizontalAlignment"
      Value="Center" />
    <Setter
      Property="VerticalAlignment"
      Value="Center" />
  </Style>
  <!--#endregion-->
  <!--#region DialogNewTaskTemplate-->
  <ControlTemplate
    x:Key="DialogNewTaskTemplate"
    TargetType="ContentControl">
    <Grid
      Style="{StaticResource DialogOverlayStyle}">
      <Border
        Style="{StaticResource DialogContainerStyle}">
        <Grid
          MinWidth="400">
          <StackPanel>
            <!-- Title -->
            <Border
              Height="30"
              Background="{DynamicResource SecondaryBackgroundBrush}"
              BorderThickness="0"
              CornerRadius="4">
              <Grid>
                <StackPanel
                  Orientation="Horizontal">
                  <TextBlock
                    Text="{Binding Title}"
                    VerticalAlignment="Center"
                    Margin="10 0 0 0" />
                </StackPanel>
                <ToggleButton
                  IsEnabled="{Binding IsProgress, Converter={StaticResource BoolReverseConverter}}"
                  Style="{StaticResource ToggleButtonIconRoundTransparent}"
                  theme:UI.IconFalse="Close"
                  theme:UI.IconTrue="Close"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Command="{Binding SupportButton}" />
              </Grid>
            </Border>
            <!-- Body -->
            <Grid
              Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="Auto" />
                <ColumnDefinition
                  Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock
                  Text="Project"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center" />
                <ComboBox
                  IsEnabled="{Binding IsNew}"
                  DisplayMemberPath="Key"
                  IsEditable="True"
                  Margin="0 10"
                  IsSynchronizedWithCurrentItem="False"
                  SelectedValue="{Binding Project}"
                  ItemsSource="{Binding Projects.Items}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger
                      EventName="KeyUp">
                      <i:InvokeCommandAction
                        Command="{Binding KeyUp}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </ComboBox>
                <TextBlock
                  Text="AssignedTo"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center" />
                <ComboBox
                  DisplayMemberPath="Name"
                  IsEditable="True"
                  Margin="0 10"
                  IsSynchronizedWithCurrentItem="False"
                  SelectedValue="{Binding User, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding Users.Items}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger
                      EventName="KeyUp">
                      <i:InvokeCommandAction
                        Command="{Binding KeyUp}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </ComboBox>
                <Grid>
                  <TextBlock
                    Text="Task"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                  <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Grid
                      Visibility="{Binding IsDuplicate, Converter={StaticResource BoolConverter}}">
                      <CheckBox
                        Visibility="{Binding IsNew, Converter={StaticResource BoolConverterReverse}}"
                        Foreground="{DynamicResource AccentBrush}"
                        Content="Only Checked"
                        IsChecked="{Binding IsOnlyChecked, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <CheckBox
                      Margin="5 0 0 0"
                      IsEnabled="{Binding IsDuplicateMust}"
                      Visibility="{Binding IsNew, Converter={StaticResource BoolConverterReverse}}"
                      Foreground="{DynamicResource AccentBrush}"
                      Content="Duplicate"
                      IsChecked="{Binding IsDuplicate, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <TextBox
                  CharacterCasing="Upper"
                  IsEnabled="{Binding IsDuplicate, Converter={StaticResource BoolReverseConverter}}"
                  Margin="0 10"
                  Text="{Binding TitleTask, UpdateSourceTrigger=PropertyChanged}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger
                      EventName="KeyUp">
                      <i:InvokeCommandAction
                        Command="{Binding KeyUp}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </TextBox>
                <TextBox
                  CharacterCasing="Upper"
                  theme:UI.Hint="Duplicate note"
                  Visibility="{Binding IsDuplicate, Converter={StaticResource BoolConverter}}"
                  Margin="0 10"
                  Text="{Binding DuplicateSupport, UpdateSourceTrigger=PropertyChanged}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger
                      EventName="KeyUp">
                      <i:InvokeCommandAction
                        Command="{Binding KeyUp}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </TextBox>
                <TextBlock
                  Text="Task Type"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center" />
                <Grid>
                  <ComboBox
                    IsEditable="True"
                    Margin="0 10"
                    IsSynchronizedWithCurrentItem="False"
                    SelectedValue="{Binding Folder}"
                    ItemsSource="{Binding Folders}">
                    <i:Interaction.Triggers>
                      <i:EventTrigger
                        EventName="KeyUp">
                        <i:InvokeCommandAction
                          Command="{Binding KeyUp}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </ComboBox>
                </Grid>
                <Grid>
                  <TextBlock
                    Text="Note"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                  <TextBlock
                    HorizontalAlignment="Right"
                    Text="Area"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                </Grid>
                <Grid>
                  <TextBox
                    CharacterCasing="Upper"
                    Margin="0 10 60 10"
                    Text="{Binding Detail, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                      <i:EventTrigger
                        EventName="KeyUp">
                        <i:InvokeCommandAction
                          Command="{Binding KeyUp}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </TextBox>
                  <TextBox
                    TextAlignment="Center"
                    Width="50"
                    HorizontalAlignment="Right"
                    Margin="0 10"
                    Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                      <i:EventTrigger
                        EventName="KeyUp">
                        <i:InvokeCommandAction
                          Command="{Binding KeyUp}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </TextBox>
                </Grid>
                <Grid
                  Margin="0 10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition
                      Width="*" />
                    <ColumnDefinition
                      Width="140" />
                    <ColumnDefinition
                      Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition
                      Height="*" />
                    <RowDefinition
                      Height="*" />
                  </Grid.RowDefinitions>
                  <DatePicker
                    SelectedDate="{Binding DateStart, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Height="30" />
                  <Grid
                    Margin="0 15 0 0"
                    Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition
                        Width="*" />
                      <ColumnDefinition
                        Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                      theme:UI.Hint="Hour"
                      Text="{Binding HourStart, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                      Margin="5 0 0 0"
                      Grid.Column="1"
                      theme:UI.Hint="Minutes"
                      Text="{Binding MinutesStart, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <TextBox
                    Margin="10 0"
                    theme:UI.Hint="Day..."
                    Grid.Column="1"
                    Text="{Binding Day, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                      <i:EventTrigger
                        EventName="KeyUp">
                        <i:InvokeCommandAction
                          Command="{Binding KeyUp}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </TextBox>
                  <DatePicker
                    IsEnabled="False"
                    SelectedDate="{Binding DateEnd, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Height="30"
                    Grid.Column="2" />
                  <Grid
                    Grid.Column="2"
                    Margin="0 15 0 0"
                    Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition
                        Width="*" />
                      <ColumnDefinition
                        Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                      theme:UI.Hint="Hour"
                      Text="{Binding HourEnd, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                      Margin="5 0 0 0"
                      Grid.Column="1"
                      theme:UI.Hint="Minutes"
                      Text="{Binding MinutesEnd, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </Grid>
              </StackPanel>
              <Border
                Margin="10 0"
                Visibility="{Binding ElementName=Interrupted, Path=IsChecked, Converter={StaticResource BoolConverter}}"
                Grid.Column="1"
                BorderThickness="0 0 1 0"
                BorderBrush="{DynamicResource PrimaryBorderBrush}" />
              <StackPanel
                Visibility="{Binding ElementName=Interrupted, Path=IsChecked, Converter={StaticResource BoolConverter}}"
                Width="300"
                Grid.Column="2">
                <TextBox
                  AcceptsReturn="True"
                  Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                  theme:UI.Hint="Search..." />
                <ListBox
                  ItemContainerStyle="{StaticResource ListBoxItemSelectedTransparent}"
                  Name="listbox"
                  ItemsSource="{Binding TasksCollection}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <CheckBox
                        Command="{Binding ElementName=listbox, Path=DataContext.SelectInterruptedCommand}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding User.Name}"
                        Content="{Binding Name}"
                        IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Grid>
            <!-- Buttons -->
            <Grid
              Margin="10">
              <CheckBox
                HorizontalAlignment="Left"
                Visibility="{Binding IsNew, Converter={StaticResource BoolConverterReverse}}"
                Name="Interrupted"
                IsChecked="{Binding IsInterrupted, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Center"
                Content="Interrupted" />
              <Popup
                Focusable="False"
                PopupAnimation="Slide"
                Placement="Left"
                PlacementTarget="{Binding ElementName=Interrupted}"
                AllowsTransparency="True"
                IsOpen="False">
                <Border
                  Style="{StaticResource DialogContainerStyle}"
                  Margin="0,0,1,0">
                  <StackPanel
                    Margin="10">
                    <TextBlock
                      Text="AssignedTo"
                      TextWrapping="Wrap"
                      VerticalAlignment="Center" />
                    <ComboBox
                      DisplayMemberPath="Name"
                      IsEditable="True"
                      Margin="0 10"
                      IsSynchronizedWithCurrentItem="False"
                      SelectedValue="{Binding SupportTaskUser, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding Users.Items, UpdateSourceTrigger=PropertyChanged}">
                      <i:Interaction.Triggers>
                        <i:EventTrigger
                          EventName="KeyUp">
                          <i:InvokeCommandAction
                            Command="{Binding KeyUp}" />
                        </i:EventTrigger>
                      </i:Interaction.Triggers>
                    </ComboBox>
                    <Grid>
                      <TextBlock
                        Text="Note"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                      <TextBlock
                        HorizontalAlignment="Right"
                        Text="Area"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                    </Grid>
                    <Grid>
                      <TextBox
                        Margin="0 10 60 10"
                        Text="{Binding SupportTaskDetail, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding KeyUp}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                      <TextBox
                        TextAlignment="Center"
                        Width="50"
                        HorizontalAlignment="Right"
                        Margin="0 10"
                        Text="{Binding SupportTaskArea, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding KeyUp}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                    </Grid>
                    <Grid
                      Margin="0 10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition
                          Width="*" />
                        <ColumnDefinition
                          Width="140" />
                        <ColumnDefinition
                          Width="*" />
                      </Grid.ColumnDefinitions>
                      <DatePicker
                        SelectedDate="{Binding SupportTaskDateStart, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Height="30" />
                      <TextBox
                        Margin="10 0"
                        theme:UI.Hint="Day..."
                        Grid.Column="1"
                        Text="{Binding SupportTaskDay, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger
                            EventName="KeyUp">
                            <i:InvokeCommandAction
                              Command="{Binding KeyUp}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </TextBox>
                      <DatePicker
                        IsEnabled="False"
                        SelectedDate="{Binding SupportTaskDateEnd, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Height="30"
                        Grid.Column="2" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Popup>
              <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <ToggleButton
                  IsEnabled="{Binding IsProgress, Converter={StaticResource BoolReverseConverter}}"
                  Visibility="{Binding SupportButtonTitle, Converter={StaticResource HasValueConverter}}"
                  MinWidth="80"
                  Content="{Binding SupportButtonTitle}"
                  Command="{Binding SupportButton}" />
                <ToggleButton
                  theme:UI.IsVisible="{Binding IsProgress}"
                  IsEnabled="{Binding IsProgress, Converter={StaticResource BoolReverseConverter}}"
                  Visibility="{Binding MainButtonTitle, Converter={StaticResource HasValueConverter}}"
                  MinWidth="80"
                  Content="{Binding MainButtonTitle}"
                  Style="{StaticResource ToggleButtonActiveProgress}"
                  Margin="10 0 0 0"
                  Command="{Binding MainButton}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </ControlTemplate>
  <!--#endregion-->
  <!--#region DialogNewUserTemplate-->
