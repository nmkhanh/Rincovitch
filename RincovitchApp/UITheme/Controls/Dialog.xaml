  <!--#endregion-->
  <!--#region DialogMessageTemplate-->
  <ControlTemplate
    x:Key="DialogMessageTemplate"
    TargetType="ContentControl">
    <Grid
      Style="{StaticResource DialogOverlayStyle}">
      <Border
        Style="{StaticResource DialogContainerStyle}">
        <Grid
          MaxWidth="800"
          MinWidth="300"
          MinHeight="100">
          <StackPanel>
            <!-- Title -->
            <Border
              Height="30"
              Background="{DynamicResource SecondaryBackgroundBrush}"
              BorderThickness="0"
              CornerRadius="4">
              <Grid>
                <StackPanel
                  Orientation="Horizontal">
                  <TextBlock
                    Text="{Binding Title}"
                    VerticalAlignment="Center"
                    Margin="10 0 0 0" />
                </StackPanel>
                <ToggleButton
                  IsEnabled="{Binding IsProgress, Converter={StaticResource BoolReverseConverter}}"
                  Style="{StaticResource ToggleButtonIconRoundTransparent}"
                  theme:UI.IconFalse="Close"
                  theme:UI.IconTrue="Close"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Command="{Binding SupportButton}" />
              </Grid>
            </Border>
            <!-- Body -->
            <Grid
              Margin="0 10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="Auto" />
                <ColumnDefinition
                  Width="*" />
              </Grid.ColumnDefinitions>
              <icon:MaterialIcon
                Visibility="{Binding Icon, Converter={StaticResource NullConverter}}"
                Width="40"
                Height="40"
                Margin="10 0 0 0"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Kind="{Binding Icon}" />
              <TextBlock
                Margin="10 0"
                Grid.Column="1"
                Text="{Binding Message}"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
            </Grid>
            <!-- Buttons -->
            <Grid
              Margin="10">
              <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <ToggleButton
                  IsEnabled="{Binding IsProgress, Converter={StaticResource BoolReverseConverter}}"
                  Visibility="{Binding SupportButtonTitle, Converter={StaticResource HasValueConverter}}"
                  MinWidth="80"
                  Content="{Binding SupportButtonTitle}"
                  Command="{Binding SupportButton}" />
                <ToggleButton
                  theme:UI.IsVisible="{Binding IsProgress}"
                  IsEnabled="{Binding IsProgress, Converter={StaticResource BoolReverseConverter}}"
                  Visibility="{Binding MainButtonTitle, Converter={StaticResource HasValueConverter}}"
                  MinWidth="80"
                  Content="{Binding MainButtonTitle}"
                  Style="{StaticResource ToggleButtonActiveProgress}"
                  Margin="10 0 0 0"
                  Command="{Binding MainButton}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </ControlTemplate>
  <!--#endregion-->
  <!--#region DialogNewProjectTemplate-->
  <ControlTemplate
    x:Key="DialogNewProjectTemplate"
    TargetType="ContentControl">
    <Grid
      Style="{StaticResource DialogOverlayStyle}">
