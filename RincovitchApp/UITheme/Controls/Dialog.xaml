                <ToggleButton
                  theme:UI.IsVisible="{Binding IsProgress}"
                  IsEnabled="{Binding IsProgress, Converter={StaticResource BoolReverseConverter}}"
                  Visibility="{Binding MainButtonTitle, Converter={StaticResource HasValueConverter}}"
                  MinWidth="80"
                  Content="{Binding MainButtonTitle}"
                  Style="{StaticResource ToggleButtonActiveProgress}"
                  Margin="10 0 0 0"
                  Command="{Binding MainButton}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </ControlTemplate>
  <!--#endregion-->
  <!--#region DialogNewLeaveTemplate-->
  <ControlTemplate
    x:Key="DialogNewLeaveTemplate"
    TargetType="ContentControl">
    <Grid
      Style="{StaticResource DialogOverlayStyle}">
      <Border
        Style="{StaticResource DialogContainerStyle}">
        <Grid
          MinWidth="400">
          <StackPanel>
            <!-- Title -->
            <Border
              Height="30"
              Background="{DynamicResource SecondaryBackgroundBrush}"
              BorderThickness="0"
              CornerRadius="4">
              <Grid>
                <StackPanel
                  Orientation="Horizontal">
                  <TextBlock
                    Text="{Binding Title}"
                    VerticalAlignment="Center"
                    Margin="10 0 0 0" />
                </StackPanel>
                <ToggleButton
                  IsEnabled="{Binding IsProgress, Converter={StaticResource BoolReverseConverter}}"
                  Style="{StaticResource ToggleButtonIconRoundTransparent}"
                  theme:UI.IconFalse="Close"
                  theme:UI.IconTrue="Close"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Command="{Binding SupportButton}" />
              </Grid>
            </Border>
            <!-- Body -->
            <Grid
              Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="Auto" />
                <ColumnDefinition
                  Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock
                  Text="Reason"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center" />
                <TextBox
                  Padding="10 5"
                  MinHeight="30"
                  Height="Auto"
                  TextWrapping="Wrap"
                  Width="400"
                  CharacterCasing="Upper"
                  Margin="0 10"
                  Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger
                      EventName="KeyUp">
                      <i:InvokeCommandAction
                        Command="{Binding KeyUp}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </TextBox>
                <TextBlock
                  Text="SendTo"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center" />
                <ComboBox
                  DisplayMemberPath="Name"
                  IsEditable="True"
                  Margin="0 10"
                  IsSynchronizedWithCurrentItem="False"
                  SelectedValue="{Binding User_Sendto}"
                  ItemsSource="{Binding Users.Items}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger
                      EventName="KeyUp">
                      <i:InvokeCommandAction
                        Command="{Binding KeyUp}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </ComboBox>
                <TextBlock
                  Text="Cc"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center" />
                <ComboBox
                  DisplayMemberPath="Name"
                  IsEditable="True"
                  Margin="0 10"
                  IsSynchronizedWithCurrentItem="False"
                  SelectedValue="{Binding User_CC}"
                  ItemsSource="{Binding Users.Items}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger
                      EventName="KeyUp">
                      <i:InvokeCommandAction
                        Command="{Binding KeyUp}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </ComboBox>
                
              </StackPanel>
            </Grid>
            <!-- Buttons -->
            <Grid
              Margin="10">
              <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <ToggleButton
                  IsEnabled="{Binding IsProgress, Converter={StaticResource BoolReverseConverter}}"
                  Visibility="{Binding SupportButtonTitle, Converter={StaticResource HasValueConverter}}"
                  MinWidth="80"
                  Content="{Binding SupportButtonTitle}"
                  Command="{Binding SupportButton}" />
                <ToggleButton
                  theme:UI.IsVisible="{Binding IsProgress}"
                  IsEnabled="{Binding IsProgress, Converter={StaticResource BoolReverseConverter}}"
                  Visibility="{Binding MainButtonTitle, Converter={StaticResource HasValueConverter}}"
                  MinWidth="80"
                  Content="{Binding MainButtonTitle}"
                  Style="{StaticResource ToggleButtonActiveProgress}"
                  Margin="10 0 0 0"
                  Command="{Binding MainButton}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </ControlTemplate>
  <!--#endregion-->
</ResourceDictionary>